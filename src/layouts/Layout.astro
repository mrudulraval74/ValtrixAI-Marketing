---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  ogType?: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  canonicalUrl = Astro.url.href,
  ogType = 'website',
  ogImage = '/og-image.svg',
  noindex = false
} = Astro.props;

const siteUrl = 'https://valtrix-ai-marketing.onrender.com';
const fullTitle = `${title} | VERIQON TECHNOLOGIES`;

// Structured Data JSON-LD Schema
const schemaData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${siteUrl}/#organization`,
      "name": "VERIQON TECHNOLOGIES",
      "alternateName": "Veriqon Technologies Inc.",
      "url": siteUrl,
      "logo": `${siteUrl}/brand/veriqon-technologies/veriqon-emblem.svg`,
      "slogan": "Engineering Trust Through Intelligence",
      "description": "Enterprise technology organisation delivering intelligent quality engineering, testing automation, and enterprise software systems."
    },
    {
      "@type": "SoftwareApplication",
      "@id": `${siteUrl}/#software`,
      "name": "VERIQON ONE",
      "applicationCategory": "DeveloperApplication",
      "operatingSystem": "Cloud / Web / On-Premise",
      "publisher": { "@id": `${siteUrl}/#organization` },
      "description": "Comprehensive Enterprise Quality Engineering Platform unifying requirements, test management, automation, ETL data validation, performance, and security testing."
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      "url": siteUrl,
      "name": "VERIQON TECHNOLOGIES",
      "publisher": { "@id": `${siteUrl}/#organization` }
    }
  ]
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    
    <!-- Primary SEO Meta Tags -->
    <title>{fullTitle}</title>
    <meta name="title" content={fullTitle} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="VERIQON TECHNOLOGIES" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={fullTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />

    <!-- Color Scheme & Theme Color -->
    <meta name="theme-color" content="#061B36" />
    <meta name="color-scheme" content="light" />

    <!-- Preload Fonts & Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
  </head>
  <body>
    <Navbar />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
