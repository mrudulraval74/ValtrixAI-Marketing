---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const demoHighlights = [
  {
    title: "Tailored Architecture Walkthrough",
    desc: "A dedicated VERIQON TECHNOLOGIES solutions architect will review your current testing challenges and model a custom quality workflow."
  },
  {
    title: "Live Studio Deep Dive",
    desc: "Hands-on demonstration of the relevant studios: AI Studio, Self-Healing Automation, ETL Data Validation, or Continuous DAST."
  },
  {
    title: "Deployment & VPC Feasibility",
    desc: "Evaluate cloud vs. dedicated single-tenant VPC vs. air-gapped on-premise installation based on your enterprise security parameters."
  }
];
---

<Layout
  title="Request a Demo — VERIQON ONE Enterprise Quality Platform"
  description="Schedule a personalized technical demonstration of VERIQON ONE with a VERIQON TECHNOLOGIES enterprise solutions architect."
>
  <section class="demo-hero">
    <div class="container text-center">
      <Breadcrumbs items={[{ label: 'Request a Demo' }]} />

      <div class="badge badge-dark">
        <span class="badge-dot"></span> LIVE PLATFORM EVALUATION
      </div>
      <h1 class="heading-xl hero-title">
        Experience VERIQON ONE in Action
      </h1>
      <p class="subheading subheading-dark hero-lead">
        Schedule a 1-on-1 technical demonstration tailored to your enterprise testing architecture and throughput requirements.
      </p>
    </div>
  </section>

  <!-- Form & Value Prop Grid -->
  <section class="section">
    <div class="container">
      <div class="demo-grid">
        <!-- Demo Form Card -->
        <div class="card form-card">
          <h2 class="heading-md">Schedule an Architectural Demo</h2>
          <p style="color: var(--text-secondary); font-size: 14px; margin-top: 6px; margin-bottom: 24px;">
            Complete the form below to connect with a designated technical specialist.
          </p>

          <form id="demo-form" class="form-layout" novalidate>
            <div class="grid-2" style="gap: 16px;">
              <div class="form-group">
                <label for="demoFirstName">First Name *</label>
                <input type="text" id="demoFirstName" name="firstName" required placeholder="Elena" class="input-field" />
                <span class="field-error" id="first-name-error">First name is required.</span>
              </div>
              <div class="form-group">
                <label for="demoLastName">Last Name *</label>
                <input type="text" id="demoLastName" name="lastName" required placeholder="Vance" class="input-field" />
                <span class="field-error" id="last-name-error">Last name is required.</span>
              </div>
            </div>

            <div class="form-group">
              <label for="demoEmail">Work Email *</label>
              <input type="email" id="demoEmail" name="email" required placeholder="elena.vance@enterprise.com" class="input-field" />
              <span class="field-error" id="demo-email-error">Please enter a valid corporate email.</span>
            </div>

            <div class="grid-2" style="gap: 16px;">
              <div class="form-group">
                <label for="demoCompany">Company / Organization *</label>
                <input type="text" id="demoCompany" name="company" required placeholder="Global Corp" class="input-field" />
                <span class="field-error" id="company-error">Company name is required.</span>
              </div>
              <div class="form-group">
                <label for="teamSize">QA / Engineering Team Size</label>
                <select id="teamSize" name="teamSize" class="input-field select-field">
                  <option value="1-20">1 - 20 engineers</option>
                  <option value="21-100">21 - 100 engineers</option>
                  <option value="101-500">101 - 500 engineers</option>
                  <option value="500+">500+ engineers (Global Enterprise)</option>
                </select>
              </div>
            </div>

            <div class="form-group">
              <label for="primaryFocus">Primary Testing Focus</label>
              <select id="primaryFocus" name="primaryFocus" class="input-field select-field">
                <option value="full-platform">Full VERIQON ONE Platform Overview</option>
                <option value="ai-synthesis">AI Requirements &amp; Test Synthesis</option>
                <option value="automation">Self-Healing Automation &amp; Regression</option>
                <option value="api">API Testing &amp; Microservice Contracts</option>
                <option value="etl">ETL &amp; Data Warehouse Vector Hashing</option>
                <option value="performance">Predictive High-Concurrency Performance</option>
                <option value="security">Continuous DAST &amp; Multi-Tenant RLS</option>
              </select>
            </div>

            <div class="form-group">
              <label for="demoNotes">Key Questions or Architecture Details</label>
              <textarea id="demoNotes" name="notes" rows="3" placeholder="Tell us about your target application stack or specific testing bottlenecks..." class="input-field textarea-field"></textarea>
            </div>

            <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 1rem;">
              Confirm Demo Reservation Request
            </button>
          </form>

          <div id="demo-success-banner" class="success-banner" style="display: none;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2.5" style="flex-shrink: 0; margin-top: 2px;">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
              <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
            <div>
              <strong style="color: #15803d; font-size: 15px; display: block;">Demo Request Received</strong>
              <p style="color: var(--text-secondary); font-size: 13.5px; margin-top: 4px; line-height: 1.6;">
                Thank you for your interest in VERIQON ONE. A solutions architect from VERIQON TECHNOLOGIES will review your details and send a calendar invitation for your tailored technical demonstration.
              </p>
            </div>
          </div>
        </div>

        <!-- Right Side: Value Highlights -->
        <div class="demo-sidebar">
          <div class="card" style="border-top: 4px solid var(--royal-blue);">
            <h3 class="heading-sm" style="color: var(--royal-blue); margin-bottom: 1rem;">What to Expect from Your Session</h3>
            
            <div class="highlight-stack">
              {demoHighlights.map((dh) => (
                <div class="highlight-item">
                  <div class="highlight-icon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0877E8" stroke-width="2.5">
                      <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                  </div>
                  <div>
                    <h4 class="highlight-title">{dh.title}</h4>
                    <p class="highlight-desc">{dh.desc}</p>
                  </div>
                </div>
              ))}
            </div>

            <div class="demo-security-guarantee">
              <span class="guarantee-label">Zero-Trust Confidentiality</span>
              <p>Your technical questions and architecture discussions are held strictly under mutual enterprise NDA standards.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .demo-hero {
    background: linear-gradient(180deg, #061B36 0%, #0A2547 100%);
    color: #FFFFFF;
    padding-top: 2rem;
    padding-bottom: 5rem;
  }

  .hero-title {
    color: #FFFFFF;
    margin-top: 1rem;
  }

  .hero-lead {
    margin-top: 1.25rem;
    margin-inline: auto;
  }

  .demo-grid {
    display: grid;
    grid-template-columns: 1.35fr 0.85fr;
    gap: 32px;
    align-items: flex-start;
  }

  @media (max-width: 900px) {
    .demo-grid {
      grid-template-columns: 1fr;
    }
  }

  .form-layout {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .form-group label {
    font-size: 13.5px;
    font-weight: 650;
    color: var(--text-primary);
  }

  .input-field {
    background: #FFFFFF;
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-sm);
    padding: 12px 14px;
    color: var(--text-primary);
    font-size: 15px;
    transition: border-color 0.18s ease, box-shadow 0.18s ease;
  }

  .input-field:focus {
    outline: none;
    border-color: var(--royal-blue);
    box-shadow: 0 0 0 3px rgba(8, 119, 232, 0.18);
  }

  .field-error {
    font-size: 12px;
    color: #dc2626;
    display: none;
  }

  .field-error.visible {
    display: block;
  }

  .success-banner {
    margin-top: 20px;
    background: #f0fdf4;
    border: 1px solid #bbf7d0;
    border-radius: var(--radius-sm);
    padding: 20px;
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }

  /* Sidebar */
  .highlight-stack {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-top: 16px;
  }

  .highlight-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }

  .highlight-icon {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: rgba(8, 119, 232, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .highlight-title {
    font-size: 14.5px;
    font-weight: 700;
    color: var(--text-primary);
  }

  .highlight-desc {
    font-size: 13px;
    color: var(--text-secondary);
    line-height: 1.55;
    margin-top: 3px;
  }

  .demo-security-guarantee {
    margin-top: 24px;
    padding-top: 16px;
    border-top: 1px solid var(--border-light);
    font-size: 12.5px;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .guarantee-label {
    display: block;
    font-size: 11px;
    font-family: var(--font-mono);
    font-weight: 750;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--royal-blue);
    margin-bottom: 2px;
  }
</style>

<script>
  const demoForm = document.getElementById('demo-form') as HTMLFormElement;
  const demoBanner = document.getElementById('demo-success-banner');
  const firstName = document.getElementById('demoFirstName') as HTMLInputElement;
  const lastName = document.getElementById('demoLastName') as HTMLInputElement;
  const email = document.getElementById('demoEmail') as HTMLInputElement;
  const company = document.getElementById('demoCompany') as HTMLInputElement;

  const fnError = document.getElementById('first-name-error');
  const lnError = document.getElementById('last-name-error');
  const emError = document.getElementById('demo-email-error');
  const coError = document.getElementById('company-error');

  if (demoForm && demoBanner) {
    demoForm.addEventListener('submit', (e) => {
      e.preventDefault();
      let valid = true;

      if (!firstName.value.trim()) {
        fnError?.classList.add('visible');
        valid = false;
      } else {
        fnError?.classList.remove('visible');
      }

      if (!lastName.value.trim()) {
        lnError?.classList.add('visible');
        valid = false;
      } else {
        lnError?.classList.remove('visible');
      }

      if (!company.value.trim()) {
        coError?.classList.add('visible');
        valid = false;
      } else {
        coError?.classList.remove('visible');
      }

      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailRegex.test(email.value.trim())) {
        emError?.classList.add('visible');
        valid = false;
      } else {
        emError?.classList.remove('visible');
      }

      if (valid) {
        demoBanner.style.display = 'flex';
        demoForm.style.display = 'none';
      }
    });
  }
</script>
