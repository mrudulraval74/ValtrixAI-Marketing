---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const offices = [
  {
    city: "New York",
    role: "Global Headquarters & Enterprise Strategy",
    desc: "Executive briefings, financial services engineering & regulatory governance."
  },
  {
    city: "San Francisco",
    role: "Core Technology & AI Research",
    desc: "Autonomous engine development, model optimization & platform runtime."
  },
  {
    city: "London",
    role: "EMEA Operations",
    desc: "European banking partnerships, regulatory compliance & enterprise support."
  }
];

const channels = [
  { label: "Enterprise Sales", value: "sales@veriqon.com", href: "mailto:sales@veriqon.com" },
  { label: "Institutional Advisory", value: "enterprise@veriqon.com", href: "mailto:enterprise@veriqon.com" },
  { label: "Security & Trust Officer", value: "security@veriqon.com", href: "mailto:security@veriqon.com" }
];
---

<Layout
  title="Contact Us — VERIQON TECHNOLOGIES"
  description="Connect with VERIQON TECHNOLOGIES enterprise sales, solutions architects, and technical advisory teams."
>
  <section class="contact-hero">
    <div class="container text-center">
      <Breadcrumbs items={[{ label: 'Contact Us' }]} />

      <div class="badge badge-dark">
        <span class="badge-dot"></span> DIRECT ENTERPRISE CHANNELS
      </div>
      <h1 class="heading-xl hero-title">
        Connect with Our Engineering Specialists
      </h1>
      <p class="subheading subheading-dark hero-lead">
        Reach our solutions architects, enterprise sales leads, or security officers directly for confidential architecture evaluations.
      </p>
    </div>
  </section>

  <!-- Contact Form & Directory -->
  <section class="section">
    <div class="container">
      <div class="contact-grid">
        <!-- Main Inquiries Form -->
        <div class="card form-card">
          <h2 class="heading-md">Send an Enterprise Inquiry</h2>
          <p style="color: var(--text-secondary); font-size: 14px; margin-top: 6px; margin-bottom: 24px;">
            Fill out the details below to route your request to the appropriate technical lead.
          </p>

          <form id="contact-form" class="form-layout" novalidate>
            <div class="form-group">
              <label for="fullName">Full Name *</label>
              <input type="text" id="fullName" name="fullName" required placeholder="e.g. Elena Vance" class="input-field" />
              <span class="field-error" id="name-error">Please provide your full name.</span>
            </div>

            <div class="form-group">
              <label for="workEmail">Work Email *</label>
              <input type="email" id="workEmail" name="workEmail" required placeholder="name@company.com" class="input-field" />
              <span class="field-error" id="email-error">Please enter a valid corporate email address.</span>
            </div>

            <div class="form-group">
              <label for="organization">Company / Organization *</label>
              <input type="text" id="organization" name="organization" required placeholder="Enterprise Corp." class="input-field" />
            </div>

            <div class="form-group">
              <label for="interest">Area of Interest</label>
              <select id="interest" name="interest" class="input-field select-field">
                <option value="platform">VERIQON ONE Platform Overview</option>
                <option value="ai-studios">Specialist Testing Studios Evaluation</option>
                <option value="vpc-deployment">Dedicated VPC / Air-Gapped Deployment</option>
                <option value="etl-data">ETL &amp; Data Warehouse Validation</option>
                <option value="performance">Performance &amp; High-Concurrency Simulation</option>
                <option value="security">Security &amp; Continuous DAST</option>
                <option value="partnership">Institutional Partnership</option>
              </select>
            </div>

            <div class="form-group">
              <label for="message">Message &amp; Architectural Context</label>
              <textarea id="message" name="message" rows="4" placeholder="Briefly describe your current testing architecture and goals..." class="input-field textarea-field"></textarea>
            </div>

            <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 1rem;">
              Submit Enterprise Inquiry
            </button>
          </form>

          <div id="form-success-banner" class="success-banner" style="display: none;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2.5" style="flex-shrink: 0; margin-top: 2px;">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
              <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
            <div>
              <strong style="color: #15803d; font-size: 15px; display: block;">Inquiry Successfully Dispatched</strong>
              <p style="color: var(--text-secondary); font-size: 13.5px; margin-top: 4px; line-height: 1.6;">
                Thank you for contacting VERIQON TECHNOLOGIES. A designated solutions architect will review your technical requirements and respond within one business day.
              </p>
            </div>
          </div>
        </div>

        <!-- Institutional Channels & Offices -->
        <div class="contact-sidebar">
          <div class="card">
            <h3 class="heading-sm" style="color: var(--royal-blue); margin-bottom: 14px;">Direct Contact Channels</h3>
            <ul class="channel-list">
              {channels.map((c) => (
                <li class="channel-item">
                  <span class="channel-lbl">{c.label}</span>
                  <a href={c.href} class="channel-link">{c.value}</a>
                </li>
              ))}
            </ul>
          </div>

          <div class="card" style="margin-top: 20px;">
            <h3 class="heading-sm" style="color: var(--royal-blue); margin-bottom: 14px;">Global Technology Briefings</h3>
            <div class="office-list">
              {offices.map((o) => (
                <div class="office-item">
                  <div class="office-head">
                    <strong class="office-city">{o.city}</strong>
                    <span class="office-role">{o.role}</span>
                  </div>
                  <p class="office-desc">{o.desc}</p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .contact-hero {
    background: linear-gradient(180deg, #061B36 0%, #0A2547 100%);
    color: #FFFFFF;
    padding-top: 2rem;
    padding-bottom: 5rem;
  }

  .hero-title {
    color: #FFFFFF;
    margin-top: 1rem;
  }

  .hero-lead {
    margin-top: 1.25rem;
    margin-inline: auto;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1.35fr 0.85fr;
    gap: 32px;
    align-items: flex-start;
  }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }

  .form-layout {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .form-group label {
    font-size: 13.5px;
    font-weight: 650;
    color: var(--text-primary);
  }

  .input-field {
    background: #FFFFFF;
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-sm);
    padding: 13px 16px;
    color: var(--text-primary);
    font-size: 15px;
    transition: border-color 0.18s ease, box-shadow 0.18s ease;
  }

  .input-field:focus {
    outline: none;
    border-color: var(--royal-blue);
    box-shadow: 0 0 0 3px rgba(8, 119, 232, 0.18);
  }

  .field-error {
    font-size: 12px;
    color: #dc2626;
    display: none;
  }

  .field-error.visible {
    display: block;
  }

  .success-banner {
    margin-top: 20px;
    background: #f0fdf4;
    border: 1px solid #bbf7d0;
    border-radius: var(--radius-sm);
    padding: 20px;
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }

  /* Sidebar */
  .channel-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .channel-item {
    border-bottom: 1px solid var(--border-light);
    padding-bottom: 12px;
  }

  .channel-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .channel-lbl {
    font-size: 11px;
    text-transform: uppercase;
    font-family: var(--font-mono);
    color: var(--text-muted);
    letter-spacing: 0.08em;
    display: block;
    margin-bottom: 2px;
  }

  .channel-link {
    color: var(--royal-blue);
    font-weight: 600;
    font-size: 14.5px;
  }

  .channel-link:hover {
    text-decoration: underline;
  }

  .office-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .office-item {
    border-bottom: 1px solid var(--border-light);
    padding-bottom: 14px;
  }

  .office-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .office-head {
    display: flex;
    flex-direction: column;
  }

  .office-city {
    font-size: 15px;
    color: var(--text-primary);
  }

  .office-role {
    font-size: 11.5px;
    color: var(--royal-blue);
    font-weight: 600;
    margin-top: 2px;
  }

  .office-desc {
    color: var(--text-secondary);
    font-size: 13px;
    line-height: 1.6;
    margin-top: 4px;
  }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const banner = document.getElementById('form-success-banner');
  const nameInput = document.getElementById('fullName') as HTMLInputElement;
  const emailInput = document.getElementById('workEmail') as HTMLInputElement;
  const nameError = document.getElementById('name-error');
  const emailError = document.getElementById('email-error');

  if (form && banner) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      let valid = true;

      if (!nameInput.value.trim()) {
        nameError?.classList.add('visible');
        valid = false;
      } else {
        nameError?.classList.remove('visible');
      }

      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailRegex.test(emailInput.value.trim())) {
        emailError?.classList.add('visible');
        valid = false;
      } else {
        emailError?.classList.remove('visible');
      }

      if (valid) {
        banner.style.display = 'flex';
        form.style.display = 'none';
      }
    });
  }
</script>
