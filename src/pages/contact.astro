---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const offices = [
  {
    city: "New York",
    role: "Global Institutional Engagements",
    desc: "Executive briefings, financial monitoring reviews, and enterprise governance partnerships."
  },
  {
    city: "San Francisco",
    role: "Engineering & AI Systems",
    desc: "Core systems architecture, model synthesis research, and industrial inspection deployments."
  }
];

const channels = [
  { label: "Institutional Inquiries", value: "contact@valtrix.ai", href: "mailto:contact@valtrix.ai" },
  { label: "Strategic Partnerships", value: "partners@valtrix.ai", href: "mailto:partners@valtrix.ai" },
  { label: "Enterprise Solutions", value: "solutions@valtrix.ai", href: "mailto:solutions@valtrix.ai" }
];
---

<Layout
  title="Contact & Workflow Evaluation"
  description="Connect with the Valtrix AI team to evaluate monitored workflows, schedule an operational briefing, or discuss deployment planning."
>
  <div class="container" style="padding-top: 2.5rem; padding-bottom: 5rem;">
    <Breadcrumbs items={[{ label: 'Contact' }]} />

    <header class="section-hero" style="padding-top: 1rem; padding-bottom: 2.5rem; text-align: center;">
      <div class="eyebrow">
        <span class="badge-dot"></span> Workflow Evaluation
      </div>
      <h1 class="title">Tell us which workflow you are evaluating</h1>
      <p class="copy" style="margin-inline: auto;">
        Share whether you are exploring financial monitoring, industrial inspection, spatial operations, or our shared platform studios, and we will route your request directly to the appropriate team.
      </p>
    </header>

    <div class="contact-grid">
      <!-- Contact & Walkthrough Form -->
      <div class="card">
        <h2 class="heading-md" style="margin-bottom: 1.5rem;">Request Monitored Workflow Briefing</h2>
        
        <form id="contact-form" class="form-layout" novalidate>
          <div class="form-group">
            <label for="fullName">Full Name <span style="color: var(--pink);">*</span></label>
            <input type="text" id="fullName" name="fullName" placeholder="Sarah Jenkins" required class="input-field" />
            <span class="field-error" id="name-error">Please enter your name</span>
          </div>

          <div class="form-group">
            <label for="workEmail">Work Email <span style="color: var(--pink);">*</span></label>
            <input type="email" id="workEmail" name="workEmail" placeholder="sarah@institution.com" required class="input-field" />
            <span class="field-error" id="email-error">Please enter a valid work email</span>
          </div>

          <div class="form-group">
            <label for="organization">Organization / Institution</label>
            <input type="text" id="organization" name="organization" placeholder="Capital Asset Partners" class="input-field" />
          </div>

          <div class="form-group">
            <label for="workflowType">Workflow Scenario Under Evaluation</label>
            <select id="workflowType" name="workflowType" class="input-field">
              <option value="platform">Complete Multi-Studio Platform Layer</option>
              <option value="financial">Financial Monitoring &amp; Risk Oversight</option>
              <option value="industrial">Industrial Vision &amp; Quality Inspection</option>
              <option value="automation">Autonomous Self-Healing Test Orchestration</option>
              <option value="etl">ETL &amp; Data Pipeline Reconciliation</option>
              <option value="security">Zero-Trust Security &amp; RLS Isolation</option>
            </select>
          </div>

          <div class="form-group">
            <label for="notes">Operating Constraints &amp; Evaluation Goals</label>
            <textarea id="notes" name="notes" rows="4" placeholder="Describe your data feeds, concurrency targets, regulatory boundaries, or deployment timeline..." class="input-field"></textarea>
          </div>

          <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 1rem;">
            Submit Evaluation Request
          </button>
        </form>

        <!-- Form Success State -->
        <div id="form-success-banner" class="success-banner" style="display: none;">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--green)" stroke-width="2">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
            <polyline points="22 4 12 14.01 9 11.01"></polyline>
          </svg>
          <div>
            <strong style="color: var(--green); font-size: 16px;">Workflow Request Formatted</strong>
            <p style="color: var(--muted); font-size: 14px; margin-top: 4px; line-height: 1.6;">
              Your evaluation parameters have been compiled. For immediate institutional scheduling, direct inquiries can be transmitted directly to <a href="mailto:contact@valtrix.ai" style="color: var(--cyan); text-decoration: underline;">contact@valtrix.ai</a>.
            </p>
          </div>
        </div>
      </div>

      <!-- Institutional Channels & Offices -->
      <div style="display: flex; flex-direction: column; gap: 20px;">
        <div class="card">
          <h3 class="heading-md" style="margin-bottom: 16px;">Institutional Channels</h3>
          <ul style="list-style: none; display: flex; flex-direction: column; gap: 16px;">
            {channels.map((c) => (
              <li style="border-bottom: 1px solid var(--stroke); padding-bottom: 12px;">
                <div style="font-size: 11px; text-transform: uppercase; font-family: var(--font-mono); color: var(--muted2); letter-spacing: 0.1em;">
                  {c.label}
                </div>
                <a href={c.href} style="color: var(--cyan); font-weight: 550; font-size: 15px;">
                  {c.value}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div class="card">
          <h3 class="heading-md" style="margin-bottom: 16px;">Office Locations</h3>
          <div style="display: flex; flex-direction: column; gap: 16px;">
            {offices.map((o) => (
              <div>
                <div style="display: flex; align-items: center; justify-content: space-between;">
                  <strong style="color: var(--text); font-size: 15px;">{o.city}</strong>
                  <span style="font-size: 11px; color: var(--cyan); font-family: var(--font-mono);">{o.role}</span>
                </div>
                <p style="color: var(--muted2); font-size: 13px; line-height: 1.6; margin-top: 4px;">
                  {o.desc}
                </p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1.35fr 0.85fr;
    gap: 32px;
    align-items: flex-start;
  }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }

  .form-layout {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .form-group label {
    font-size: 14px;
    font-weight: 550;
    color: var(--muted);
  }

  .input-field {
    background: rgba(255, 255, 255, 0.035);
    border: 1px solid var(--stroke);
    border-radius: var(--radius-sm);
    padding: 14px 18px;
    color: var(--text);
    font-size: 15px;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .input-field:focus {
    outline: none;
    border-color: var(--cyan);
    box-shadow: 0 0 0 2px rgba(121, 243, 255, 0.2);
  }

  .field-error {
    font-size: 12px;
    color: var(--pink);
    display: none;
  }

  .field-error.visible {
    display: block;
  }

  .success-banner {
    margin-top: 20px;
    background: rgba(78, 240, 193, 0.08);
    border: 1px solid rgba(78, 240, 193, 0.25);
    border-radius: var(--radius-sm);
    padding: 20px;
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const banner = document.getElementById('form-success-banner');
  const nameInput = document.getElementById('fullName') as HTMLInputElement;
  const emailInput = document.getElementById('workEmail') as HTMLInputElement;
  const nameError = document.getElementById('name-error');
  const emailError = document.getElementById('email-error');

  if (form && banner) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      let valid = true;

      if (!nameInput.value.trim()) {
        nameError?.classList.add('visible');
        valid = false;
      } else {
        nameError?.classList.remove('visible');
      }

      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailRegex.test(emailInput.value.trim())) {
        emailError?.classList.add('visible');
        valid = false;
      } else {
        emailError?.classList.remove('visible');
      }

      if (valid) {
        banner.style.display = 'flex';
        form.style.display = 'none';
      }
    });
  }
</script>
