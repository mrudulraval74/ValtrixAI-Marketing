---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import StudioMockup from '../../components/StudioMockup.astro';
import CtaSection from '../../components/CtaSection.astro';

const secCapabilities = [
  {
    title: "Automated DAST Penetration Testing",
    desc: "Executes continuous dynamic probing across running application endpoints, testing against OWASP Top 10 vulnerabilities, injection flaws, and SSRF vectors."
  },
  {
    title: "Multi-Tenant Isolation Verification",
    desc: "Rigorously verifies Row-Level Security (RLS) policies and cross-organization boundaries to guarantee zero unauthorized cross-tenant data leakage."
  },
  {
    title: "RBAC & Authorization Matrix Audits",
    desc: "Tests every combination of user roles, scopes, and permission tokens to detect privilege escalation loopholes and broken object-level authorization (BOLA)."
  },
  {
    title: "Cryptographic & Compliance Verification",
    desc: "Validates TLS cipher configurations, cookie security flags, token expiration handling, and cryptographic key rotation compliance."
  }
];
---

<Layout
  title="Security Studio — VERIQON ONE Continuous DAST & Tenant Isolation"
  description="Explore Security Studio in VERIQON ONE, developed by VERIQON TECHNOLOGIES: continuous zero-trust security auditing, automated DAST, and multi-tenant RLS verification."
>
  <div class="container" style="padding-top: 2rem;">
    <Breadcrumbs items={[{ label: 'Specialist Studios', href: '/ai-studios' }, { label: 'Security Studio' }]} />

    <header class="section-hero" style="padding-top: 1rem; padding-bottom: 2rem;">
      <div class="badge">
        <span class="badge-dot"></span> VERIQON ONE SPECIALIST STUDIO
      </div>
      <h1 class="heading-xl">Security Studio</h1>
      <p class="subheading">
        Continuous zero-trust security auditing, automated DAST penetration probing, and multi-tenant Row-Level Security isolation verification.
      </p>
    </header>

    <StudioMockup
      studioName="Security Studio"
      stageBadge="ZERO-TRUST COMPLIANCE"
      activeTab="Security Audit"
      executionMetrics={[
        { label: "OWASP Probes Passed", value: "248/248", status: "pass" },
        { label: "Tenant Isolation Violations", value: "0", status: "pass" },
        { label: "Audit Ledger Signed", value: "Verified", status: "pass" }
      ]}
      codeSnippet={`// VERIQON ONE Multi-Tenant Isolation Audit
const securityAudit = await veriqon.auditTenantIsolation({
  tenantA: "ENTERPRISE_ORG_ALPHA",
  tenantB: "ENTERPRISE_ORG_BETA",
  boundaryCheck: "STRICT_ROW_LEVEL_SECURITY_POLICIES",
  fuzzUserContexts: true
});`}
    />

    <section class="section" style="padding-top: 2rem;">
      <div class="text-center section-header">
        <h2 class="heading-lg">Zero-Trust Enterprise Security</h2>
        <p class="subheading">Catch authorization leaks, broken object-level controls, and injection vectors before production release.</p>
      </div>

      <div class="grid-2">
        {secCapabilities.map((c) => (
          <div class="card">
            <h3 class="heading-md" style="color: var(--royal-blue);">{c.title}</h3>
            <p style="color: var(--text-secondary); font-size: 14px; line-height: 1.7; margin-top: 8px;">
              {c.desc}
            </p>
          </div>
        ))}
      </div>
    </section>

    <CtaSection
      title="Verify Your Security Posture on Every Deployment"
      subtitle="Speak with VERIQON TECHNOLOGIES security specialists to evaluate your zero-trust tenant isolation."
      primaryCtaText="Request a Demo"
      primaryCtaHref="/request-demo"
      secondaryCtaText="Explore Manual Testing Studio"
      secondaryCtaHref="/studios/manual-testing"
    />
  </div>
</Layout>
