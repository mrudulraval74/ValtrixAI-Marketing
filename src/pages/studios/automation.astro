---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import StudioMockup from '../../components/StudioMockup.astro';
import CtaSection from '../../components/CtaSection.astro';

const features = [
  {
    title: "Autonomous DOM Self-Healing",
    desc: "Uses contextual multi-modal locator graphs to identify UI elements even when class names, IDs, or component hierarchies shift."
  },
  {
    title: "Parallel Distributed Orchestration",
    desc: "Distributes thousands of browser, mobile, and API tests across isolated workers with dynamic load rebalancing."
  },
  {
    title: "Framework Neutral Interoperability",
    desc: "Executes seamlessly alongside Playwright, Cypress, Selenium, and custom internal test drivers without vendor lock-in."
  },
  {
    title: "Visual Regression & Layout Invariance",
    desc: "Detects unintended layout shifts and color palette drift while filtering out false positives from dynamic content."
  }
];
---

<Layout
  title="Automation Studio — VERIQON ONE Self-Healing Test Orchestration"
  description="Explore Automation Studio in VERIQON ONE, developed by VERIQON TECHNOLOGIES: delivers resilient test automation with autonomous DOM self-healing, and zero flakiness."
>
  <div class="container" style="padding-top: 2rem;">
    <Breadcrumbs items={[{ label: 'Specialist Studios', href: '/ai-studios' }, { label: 'Automation Studio' }]} />

    <header class="section-hero" style="padding-top: 1rem; padding-bottom: 2rem;">
      <div class="badge">
        <span class="badge-dot"></span> VERIQON ONE SPECIALIST STUDIO
      </div>
      <h1 class="heading-xl">Automation Studio</h1>
      <p class="subheading">
        Engineered to eliminate test maintenance overhead. Autonomous self-healing selectors adapt to code releases in real-time, keeping CI/CD pipelines green.
      </p>
    </header>

    <StudioMockup
      studioName="Automation Studio Engine"
      stageBadge="SELF-HEALING RUNTIME"
      activeTab="Execution Trace"
      executionMetrics={[
        { label: "Tests Executed", value: "1,240", status: "pass" },
        { label: "Self-Healed Selectors", value: "18 Resolved", status: "warn" },
        { label: "Execution Time", value: "1m 42s", status: "info" }
      ]}
      codeSnippet={`// VERIQON ONE Self-Healing Selector Engine
await page.locator(veriqon.adaptiveSelector({
  semanticRole: "button",
  intent: "SUBMIT_PAYMENT",
  fallbacks: ["#pay-btn", "[data-testid=checkout]", ".btn-submit"]
})).click();`}
    />

    <section class="section" style="padding-top: 2rem;">
      <div class="text-center section-header">
        <h2 class="heading-lg">Resilient Automation Capabilities</h2>
        <p class="subheading">Eliminate routine test maintenance overhead with intelligent self-healing algorithms.</p>
      </div>

      <div class="grid-2">
        {features.map((item) => (
          <div class="card">
            <h3 class="heading-md" style="color: var(--royal-blue);">{item.title}</h3>
            <p style="color: var(--text-secondary); font-size: 14px; line-height: 1.7; margin-top: 8px;">
              {item.desc}
            </p>
          </div>
        ))}
      </div>
    </section>

    <CtaSection
      title="Eliminate Flaky Test Failures in Your CI/CD Pipeline"
      subtitle="Talk to a VERIQON TECHNOLOGIES engineer to test self-healing automation on your own web and mobile applications."
      primaryCtaText="Request a Demo"
      primaryCtaHref="/request-demo"
      secondaryCtaText="Explore API Testing Studio"
      secondaryCtaHref="/studios/api-testing"
    />
  </div>
</Layout>
