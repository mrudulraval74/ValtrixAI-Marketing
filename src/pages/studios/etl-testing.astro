---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import StudioMockup from '../../components/StudioMockup.astro';
import CtaSection from '../../components/CtaSection.astro';

const dataFeatures = [
  {
    title: "High-Throughput Vector Hashing",
    desc: "Reconciles multi-million row datasets in seconds using distributed SIMD vector hashing to verify complete data parity between source and target systems."
  },
  {
    title: "Continuous Schema Drift Detection",
    desc: "Monitors upstream tables and downstream warehouse schemas, flagging altered column types, missing fields, or unexpected nullability changes."
  },
  {
    title: "Transformation Logic Verification",
    desc: "Mathematically verifies SQL transformation scripts, dbt models, and Spark jobs against declared business rules and aggregate assertions."
  },
  {
    title: "Data Warehouse Connectors",
    desc: "Native high-speed integration with Snowflake, Google BigQuery, Databricks Lakehouse, AWS Redshift, PostgreSQL, and Apache Iceberg."
  }
];
---

<Layout
  title="ETL / Data Testing Studio — VERIQON ONE Data Pipeline Integrity"
  description="Explore the ETL / Data Testing Studio in VERIQON ONE, developed by VERIQON TECHNOLOGIES: verify data warehouses, transformation logic, and row-level pipeline integrity."
>
  <div class="container" style="padding-top: 2rem;">
    <Breadcrumbs items={[{ label: 'Specialist Studios', href: '/ai-studios' }, { label: 'ETL / Data Testing Studio' }]} />

    <header class="section-hero" style="padding-top: 1rem; padding-bottom: 2rem;">
      <div class="badge">
        <span class="badge-dot"></span> VERIQON ONE SPECIALIST STUDIO
      </div>
      <h1 class="heading-xl">ETL / Data Testing Studio</h1>
      <p class="subheading">
        Enterprise data warehouse validation, row-level vector hashing, and continuous pipeline reconciliation across multi-million row datasets.
      </p>
    </header>

    <StudioMockup
      studioName="ETL / Data Testing Studio"
      stageBadge="DATA WAREHOUSE INTEGRITY"
      activeTab="Data Reconciliation"
      executionMetrics={[
        { label: "Rows Reconciled", value: "48.2M", status: "pass" },
        { label: "Vector Hash Mismatches", value: "0", status: "pass" },
        { label: "Throughput", value: "1.4M rows/s", status: "info" }
      ]}
      codeSnippet={`// VERIQON ONE High-Throughput Data Reconciliation
const validation = await veriqon.reconcileDatasets({
  source: "POSTGRESQL_PROD_REPLICA",
  target: "SNOWFLAKE_FIN_DW",
  strategy: "DISTRIBUTED_VECTOR_HASH_RECONCILIATION",
  tolerance: 0.00000
});`}
    />

    <section class="section" style="padding-top: 2rem;">
      <div class="text-center section-header">
        <h2 class="heading-lg">Enterprise Data Verification</h2>
        <p class="subheading">Certify your analytics, machine learning pipelines, and regulatory reporting on mathematically verified data.</p>
      </div>

      <div class="grid-2">
        {dataFeatures.map((f) => (
          <div class="card">
            <h3 class="heading-md" style="color: var(--royal-blue);">{f.title}</h3>
            <p style="color: var(--text-secondary); font-size: 14px; line-height: 1.7; margin-top: 8px;">
              {f.desc}
            </p>
          </div>
        ))}
      </div>
    </section>

    <CtaSection
      title="Protect Your Data Warehouse from Silent Corruption"
      subtitle="Schedule a consultation with VERIQON TECHNOLOGIES data engineers to benchmark your pipeline reconciliation."
      primaryCtaText="Request a Demo"
      primaryCtaHref="/request-demo"
      secondaryCtaText="Explore Performance Studio"
      secondaryCtaHref="/studios/performance-testing"
    />
  </div>
</Layout>
