---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import StudioMockup from '../../components/StudioMockup.astro';
import CtaSection from '../../components/CtaSection.astro';

const manualFeatures = [
  {
    title: "AI-Assisted Session Capture",
    desc: "Records exploratory test sessions with DOM element references, user click streams, network timing, and console error events."
  },
  {
    title: "Instant Defect Ticket Synthesis",
    desc: "Transforms recorded exploratory bugs into structured, reproduction-ready Jira and GitHub issues with clean step-by-step instructions."
  },
  {
    title: "Session Replay & State Diffing",
    desc: "Allows engineers to visually replay defective sessions alongside state snapshots to isolate root causes in minutes."
  },
  {
    title: "Automated Regression Conversion",
    desc: "Converts manual test paths into permanent, automated self-healing test scripts with a single click."
  }
];
---

<Layout
  title="Manual Testing Studio — VERIQON ONE AI-Assisted Exploratory QA"
  description="Explore Manual Testing Studio in VERIQON ONE, developed by VERIQON TECHNOLOGIES: transforms exploratory sessions into structured, reproducible defect assets."
>
  <div class="container" style="padding-top: 2rem;">
    <Breadcrumbs items={[{ label: 'Specialist Studios', href: '/ai-studios' }, { label: 'Manual Testing Studio' }]} />

    <header class="section-hero" style="padding-top: 1rem; padding-bottom: 2rem;">
      <div class="badge">
        <span class="badge-dot"></span> VERIQON ONE SPECIALIST STUDIO
      </div>
      <h1 class="heading-xl">Manual Testing Studio</h1>
      <p class="subheading">
        AI-assisted exploratory flows, automatic step-by-step defect reproduction synthesis, and seamless conversion into permanent automated regression suites.
      </p>
    </header>

    <StudioMockup
      studioName="Manual Testing Studio"
      stageBadge="EXPLORATORY &amp; REPLAY"
      activeTab="Exploratory Session"
      executionMetrics={[
        { label: "Steps Recorded", value: "34 Actions", status: "info" },
        { label: "Reproduction Accuracy", value: "100%", status: "pass" },
        { label: "Defect Draft Synthesized", value: "Ready", status: "pass" }
      ]}
      codeSnippet={`// VERIQON ONE Session Replay & Defect Exporter
const defectTicket = await veriqon.exportExploratoryDefect({
  sessionId: "SESSION_EXP_2026_114",
  targetTracker: "JIRA_ENTERPRISE_CLOUD",
  includeNetworkLogs: true,
  generateAutomatedRegressionTest: true
});`}
    />

    <section class="section" style="padding-top: 2rem;">
      <div class="text-center section-header">
        <h2 class="heading-lg">Supercharged Exploratory Testing</h2>
        <p class="subheading">Empower manual QA professionals with intelligent reproduction tools and instant automation handoff.</p>
      </div>

      <div class="grid-2">
        {manualFeatures.map((f) => (
          <div class="card">
            <h3 class="heading-md" style="color: var(--royal-blue);">{f.title}</h3>
            <p style="color: var(--text-secondary); font-size: 14px; line-height: 1.7; margin-top: 8px;">
              {f.desc}
            </p>
          </div>
        ))}
      </div>
    </section>

    <CtaSection
      title="Bridge the Gap Between Exploratory QA and Automated CI/CD"
      subtitle="See how VERIQON ONE empowers QA engineers to build automated regression suites from everyday exploratory testing."
      primaryCtaText="Request a Demo"
      primaryCtaHref="/request-demo"
      secondaryCtaText="View All 7 Studios"
      secondaryCtaHref="/ai-studios"
    />
  </div>
</Layout>
