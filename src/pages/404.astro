---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page Not Found (404)"
  description="The requested page could not be located on the Valtrix AI Quality Engineering website."
  noindex={true}
>
  <div class="container" style="padding-top: 6rem; padding-bottom: 8rem; text-align: center;">
    <div class="badge" style="color: #f43f5e; border-color: rgba(244, 63, 94, 0.4); background: rgba(244, 63, 94, 0.1);">
      <span class="badge-dot" style="background: #f43f5e; box-shadow: 0 0 8px #f43f5e;"></span> Error 404
    </div>
    <h1 class="heading-xl">Route Not Found</h1>
    <p class="subheading" style="margin-bottom: 2.5rem;">
      The requested endpoint or document does not exist in the Valtrix AI marketing index.
    </p>

    <div class="btn-group">
      <a href="/" class="btn btn-primary">Return to Homepage</a>
      <a href="/platform" class="btn btn-secondary">Explore Platform Studios</a>
    </div>
  </div>
</Layout>

