---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page Not Found (404) | VERIQON TECHNOLOGIES"
  description="The requested page could not be located on the VERIQON TECHNOLOGIES website."
  noindex={true}
>
  <div class="container" style="padding-top: 6rem; padding-bottom: 8rem; text-align: center;">
    <div class="badge" style="color: #f43f5e; border-color: rgba(244, 63, 94, 0.4); background: rgba(244, 63, 94, 0.08); margin: 0 auto 1.5rem auto;">
      <span class="badge-dot" style="background: #f43f5e; box-shadow: 0 0 8px #f43f5e;"></span> Error 404
    </div>
    <h1 class="heading-xl">Route Not Located</h1>
    <p class="subheading" style="margin: 1rem auto 2.5rem auto; max-width: 580px;">
      The requested endpoint or document does not exist or has been restructured under the VERIQON ONE platform architecture.
    </p>

    <div class="btn-group" style="justify-content: center;">
      <a href="/" class="btn btn-primary">Return to Homepage</a>
      <a href="/platform" class="btn btn-secondary">Explore Platform</a>
      <a href="/ai-studios" class="btn btn-secondary">Browse 7 Studios</a>
    </div>
  </div>
</Layout>
