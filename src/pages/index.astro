---
import Layout from '../layouts/Layout.astro';
import StudioMockup from '../components/StudioMockup.astro';
import CtaSection from '../components/CtaSection.astro';

const studios = [
  {
    title: 'AI End-to-End Studio',
    tag: 'Autonomous Synthesis',
    desc: 'Unifies requirements ingestion, architecture discovery, zero-trust review, and self-healing test generation into one governed workspace.',
    href: '/studios/ai-end-to-end',
    iconColor: '#c084fc'
  },
  {
    title: 'Automation Studio',
    tag: 'Self-Healing Engine',
    desc: 'Eliminates test suite flakiness through autonomous DOM-change compensation, dynamic selector recovery, and parallel execution orchestration.',
    href: '/studios/automation',
    iconColor: '#60a5fa'
  },
  {
    title: 'ETL Testing Studio',
    tag: 'Data Pipeline Integrity',
    desc: 'Continuous schema reconciliation, row-level vector hashing, and high-throughput data warehouse verification across source-to-target runs.',
    href: '/studios/etl-testing',
    iconColor: '#34d399'
  },
  {
    title: 'Performance Testing Studio',
    tag: 'Predictive Load Analysis',
    desc: 'Synthetic user generation, bottleneck forecasting, and latency breakdown across multi-tenant services and high-concurrency microservices.',
    href: '/studios/performance-testing',
    iconColor: '#f59e0b'
  },
  {
    title: 'Security Testing Studio',
    tag: 'Automated DAST & RLS',
    desc: 'Continuous zero-trust audit, tenant isolation verification, automated penetration probing, and Row-Level Security policy compliance.',
    href: '/studios/security-testing',
    iconColor: '#f43f5e'
  },
  {
    title: 'Manual Testing Studio',
    tag: 'AI-Assisted Exploratory',
    desc: 'Intelligent test session recording, automated defect draft synthesis, and step-by-step reproduction capture for QA engineers.',
    href: '/studios/manual-testing',
    iconColor: '#a78bfa'
  }
];

const pillars = [
  {
    title: "100% Requirements Traceability",
    description: "Every test case, defect, and synthesized test step connects directly to business requirements and verified architecture models."
  },
  {
    title: "Zero-Trust Architecture",
    description: "Full tenant isolation, cryptographic state validation, and strict RBAC controls embedded into every automated testing stage."
  },
  {
    title: "Local or Enterprise Model Hosting",
    description: "Run private local models via Ollama or connect enterprise LLM endpoints without leaking sensitive proprietary application schemas."
  }
];
---

<Layout 
  title="Autonomous AI Quality Engineering Platform" 
  description="Valtrix AI delivers enterprise autonomous testing studios, self-healing test automation, ETL pipeline validation, and full requirements traceability."
>
  <!-- Hero Section -->
  <section class="section section-hero">
    <div class="container">
      <div class="badge">
        <span class="badge-dot"></span> Next-Gen AI Quality Engineering
      </div>
      <h1 class="heading-xl">
        Autonomous Quality Engineering for <br/>
        <span class="gradient-text">Mission-Critical Enterprise Systems</span>
      </h1>
      <p class="subheading">
        Valtrix AI unifies requirement analysis, architecture discovery, self-healing test execution, and data validation into intelligent, specialized studios.
      </p>

      <div class="btn-group">
        <a href="/contact" class="btn btn-primary">Schedule Enterprise Walkthrough</a>
        <a href="/platform" class="btn btn-secondary">Explore Architecture &amp; Studios</a>
      </div>

      <!-- Hero Studio Preview Mockup -->
      <StudioMockup 
        studioName="Unified AI Quality Studio"
        stageBadge="LIVE RUNTIME GOVERNANCE"
        activeTab="Architecture Review"
      />
    </div>
  </section>

  <!-- Core Pillars Section -->
  <section class="section">
    <div class="container">
      <div class="section-header text-center">
        <h2 class="heading-lg">Engineering-First Foundation</h2>
        <p class="subheading">Built for reliability, enterprise scale, and deterministic quality outcomes.</p>
      </div>

      <div class="grid-3" style="margin-top: 3rem;">
        {pillars.map((pillar) => (
          <div class="card card-feature">
            <div class="feature-icon-wrapper">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              </svg>
            </div>
            <h3 class="heading-md">{pillar.title}</h3>
            <p style="color: var(--text-muted); font-size: 0.95rem; line-height: 1.6;">{pillar.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Six Studios Section -->
  <section class="section" id="studios">
    <div class="container">
      <div class="section-header text-center">
        <div class="badge">
          <span class="badge-dot"></span> Specialized Testing Workspaces
        </div>
        <h2 class="heading-lg">The Valtrix AI Studio Ecosystem</h2>
        <p class="subheading">
          Dedicated testing studios engineered to address every facet of modern software verification.
        </p>
      </div>

      <div class="grid-3" style="margin-top: 3rem;">
        {studios.map((s) => (
          <a href={s.href} class="card studio-card" aria-label={`Learn more about ${s.title}`}>
            <div class="studio-tag" style={`color: ${s.iconColor};`}>{s.tag}</div>
            <h3 class="heading-md" style="margin-top: 0.5rem;">{s.title}</h3>
            <p class="studio-desc">{s.desc}</p>
            <div class="studio-arrow">
              <span>Explore Studio</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Call to Action -->
  <CtaSection />
</Layout>

<style>
  .text-center {
    text-align: center;
  }

  .studio-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    text-decoration: none;
  }

  .studio-tag {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    text-transform: uppercase;
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .studio-desc {
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.6;
    margin-top: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .studio-arrow {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--primary-accent);
    margin-top: auto;
    transition: gap 0.2s ease;
  }

  .studio-card:hover .studio-arrow {
    gap: 0.7rem;
  }
</style>

