---
import Layout from '../layouts/Layout.astro';
import StudioMockup from '../components/StudioMockup.astro';
import CtaSection from '../components/CtaSection.astro';

const operationalScenarios = [
  {
    title: "Financial Monitoring",
    tag: "Capital & Risk Signals",
    desc: "Portfolio oversight, anomaly detection, and governed escalation for teams that need monitored signals translated into accountable action.",
    color: "#61adff"
  },
  {
    title: "Industrial Inspection",
    tag: "Computer Vision & Line QA",
    desc: "Line monitoring, defect triage, and automated operator review where inspection must be fast, visible, and mathematically auditable.",
    color: "#9d7dff"
  },
  {
    title: "Spatial Operations",
    tag: "Sensor Fusion & Live Assets",
    desc: "Live asset monitoring, telemetry review, and spatial awareness for operators who need clear queues, current states, and coordinated response paths.",
    color: "#ff6fd7"
  }
];

const studios = [
  {
    title: 'AI End-to-End Studio',
    tag: 'Autonomous Synthesis',
    desc: 'Unifies requirements ingestion, architecture discovery, zero-trust review, and self-healing test generation into one governed workspace.',
    href: '/studios/ai-end-to-end',
    color: '#79f3ff'
  },
  {
    title: 'Automation Studio',
    tag: 'Self-Healing Engine',
    desc: 'Eliminates test suite flakiness through autonomous DOM-change compensation, dynamic selector recovery, and parallel execution orchestration.',
    href: '/studios/automation',
    color: '#61adff'
  },
  {
    title: 'ETL Testing Studio',
    tag: 'Data Pipeline Integrity',
    desc: 'Continuous schema reconciliation, row-level vector hashing, and high-throughput data warehouse verification across source-to-target runs.',
    href: '/studios/etl-testing',
    color: '#4ef0c1'
  },
  {
    title: 'Performance Testing Studio',
    tag: 'Predictive Load Analysis',
    desc: 'Synthetic user generation, bottleneck forecasting, and latency breakdown across multi-tenant services and high-concurrency microservices.',
    href: '/studios/performance-testing',
    color: '#f59e0b'
  },
  {
    title: 'Security Testing Studio',
    tag: 'Automated DAST & RLS',
    desc: 'Continuous zero-trust audit, tenant isolation verification, automated penetration probing, and Row-Level Security policy compliance.',
    href: '/studios/security-testing',
    color: '#ff6fd7'
  },
  {
    title: 'Manual Testing Studio',
    tag: 'AI-Assisted Exploratory',
    desc: 'Intelligent test session recording, automated defect draft synthesis, and step-by-step reproduction capture for QA engineers.',
    href: '/studios/manual-testing',
    color: '#9d7dff'
  }
];

const operatingTheses = [
  {
    step: "01",
    title: "Connect Sources",
    desc: "Bring structured data, telemetry feeds, machine signals, documents, and live operational inputs into one unified intake layer."
  },
  {
    step: "02",
    title: "Generate Signals",
    desc: "Transform noisy inputs into probabilistic models, risk classifications, deterministic anomaly scores, and executive summaries."
  },
  {
    step: "03",
    title: "Human Review",
    desc: "Keep validation, policy override, and high-stakes escalation inside governed, auditable team review queues."
  },
  {
    step: "04",
    title: "Traceable Outcomes",
    desc: "Every automated test execution, routed decision, and remediated defect is recorded with complete cryptographic lineage."
  }
];
---

<Layout 
  title="Strategic Intelligence Systems & Quality Engineering" 
  description="Valtrix AI builds intelligence systems for financial monitoring, industrial inspection, and autonomous quality engineering decision workflows."
>
  <!-- Hero Section -->
  <section class="section section-hero" style="padding-top: 3.5rem; padding-bottom: 4rem; text-align: center;">
    <div class="container">
      <div class="eyebrow" style="margin-inline: auto;">
        <span class="badge-dot"></span> Operational Intelligence Systems
      </div>
      <h1 class="title">
        Operational intelligence for <br />
        <span class="gradient-text">monitored workflows</span>
      </h1>
      <p class="copy" style="margin-inline: auto;">
        Valtrix AI builds software for monitored workflows where teams need clear signals, governed review, and fast routing under real operating constraints.
      </p>

      <div class="btn-row" style="justify-content: center; margin-top: 2rem;">
        <a href="/contact" class="btn btn-primary">Schedule Monitored Walkthrough</a>
        <a href="/platform" class="btn btn-secondary">Explore Platform Architecture</a>
      </div>

      <!-- Live Interactive Console Mockup -->
      <StudioMockup 
        studioName="Unified Monitoring & Testing Engine"
        stageBadge="LIVE RUNTIME CONSOLE"
        activeTab="Risk & Exposure"
      />
    </div>
  </section>

  <!-- Three Monitored Workflow Scenarios -->
  <section class="section" style="padding-top: 1rem;">
    <div class="container">
      <div style="text-align: center; margin-bottom: 3rem;">
        <div class="eyebrow" style="margin-inline: auto;">
          <span class="badge-dot"></span> Core Scenarios
        </div>
        <h2 class="heading-lg">Three Monitored-Workflow Scenarios</h2>
        <p class="copy" style="margin-inline: auto;">
          A single operating model for teams that monitor signals, review risk, and route decisions across finance, industrial environments, and spatial systems.
        </p>
      </div>

      <div class="grid-3">
        {operationalScenarios.map((item) => (
          <div class="card">
            <div class="scenario-tag" style={`color: ${item.color};`}>{item.tag}</div>
            <h3 class="heading-md" style="margin-top: 8px;">{item.title}</h3>
            <p style="color: var(--muted); font-size: 15px; line-height: 1.7; margin-top: 10px;">
              {item.desc}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Six Studios Section -->
  <section class="section" id="studios">
    <div class="container">
      <div style="text-align: center; margin-bottom: 3rem;">
        <div class="eyebrow" style="margin-inline: auto;">
          <span class="badge-dot"></span> Specialized Studios
        </div>
        <h2 class="heading-lg">Connected Quality Studios</h2>
        <p class="copy" style="margin-inline: auto;">
          Six specialized testing studios providing deep domain intelligence backed by one shared review, routing, and governance platform.
        </p>
      </div>

      <div class="grid-3">
        {studios.map((s) => (
          <a href={s.href} class="card studio-card" aria-label={`Learn more about ${s.title}`}>
            <div>
              <div class="scenario-tag" style={`color: ${s.color};`}>{s.tag}</div>
              <h3 class="heading-md" style="margin-top: 8px; color: var(--text);">{s.title}</h3>
              <p style="color: var(--muted); font-size: 14px; line-height: 1.6; margin-top: 10px;">
                {s.desc}
              </p>
            </div>
            <div class="studio-link" style={`color: ${s.color};`}>
              <span>Explore Studio</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Shared Operating Thesis -->
  <section class="section">
    <div class="container">
      <div style="text-align: center; margin-bottom: 3rem;">
        <div class="eyebrow" style="margin-inline: auto;">
          <span class="badge-dot"></span> Operating Model
        </div>
        <h2 class="heading-lg">From Fragmented Signals to Governed Action</h2>
        <p class="copy" style="margin-inline: auto;">
          How the platform ingests live telemetry, classifies risk, and routes verified human reviews.
        </p>
      </div>

      <div class="grid-2">
        {operatingTheses.map((thesis) => (
          <div class="card">
            <div class="step-badge">{thesis.step}</div>
            <h3 class="heading-md" style="margin-top: 10px;">{thesis.title}</h3>
            <p style="color: var(--muted); font-size: 15px; line-height: 1.7; margin-top: 8px;">
              {thesis.desc}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Call to Action -->
  <CtaSection />
</Layout>

<style>
  .scenario-tag {
    font-size: 11px;
    font-family: var(--font-mono);
    text-transform: uppercase;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .studio-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    text-decoration: none;
  }

  .studio-link {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    font-weight: 600;
    margin-top: 24px;
    transition: gap 0.2s ease;
  }

  .studio-card:hover .studio-link {
    gap: 10px;
  }

  .step-badge {
    font-size: 16px;
    font-family: var(--font-mono);
    font-weight: 800;
    color: var(--cyan);
  }
</style>
