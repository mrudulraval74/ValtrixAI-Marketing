---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import StudioMockup from '../components/StudioMockup.astro';
import CtaSection from '../components/CtaSection.astro';

const platformPillars = [
  {
    step: "01",
    title: "Requirements Ingestion & Discovery",
    desc: "Ingests business requirements from Jira, Confluence, OpenAPI specifications, and event schemas with zero-trust perimeter isolation.",
    capabilities: ["Jira & Confluence Sync", "OpenAPI & AsyncAPI Parsing", "Architecture Graph Mapping"]
  },
  {
    step: "02",
    title: "AI Synthesis & Reasoning Topology",
    desc: "Applies specialized multi-modal models to infer user journeys, calculate risk boundaries, synthesize edge cases, and create immutable configuration plans.",
    capabilities: ["Autonomous Test Suite Generation", "Dynamic Fixture Synthesis", "Boundary & Edge Prediction"]
  },
  {
    step: "03",
    title: "Self-Healing Execution Fabric",
    desc: "Executes distributed test graphs across local, containerized, or private VPC target endpoints, repairing selector drifts and DOM fluctuations dynamically.",
    capabilities: ["Dynamic DOM Self-Healing", "Cross-Browser Virtual Grid", "Parallel Sharded Runners"]
  },
  {
    step: "04",
    title: "Continuous Governance & Traceability",
    desc: "Provides human-in-the-loop review gates, approval checkpoints, RBAC enforcement, and audit trail persistence before any test script or execution occurs.",
    capabilities: ["Zero-Trust RBAC", "Cryptographic Audit Ledger", "Bi-directional Defect Traceability"]
  }
];

const coreCapabilities = [
  {
    title: "Requirements Management",
    desc: "Treat requirements as living verification models. Auto-generate test conditions whenever acceptance criteria drift.",
    badge: "CORE ENGINE"
  },
  {
    title: "Unified Test Management",
    desc: "Single pane of glass across manual exploratory scripts, automated runs, load simulations, and security scans.",
    badge: "MANAGEMENT"
  },
  {
    title: "Intelligent Execution Engine",
    desc: "High-throughput parallel test execution engine with smart test selection to run only impacted tests on PR builds.",
    badge: "EXECUTION"
  },
  {
    title: "Continuous Defect Triaging",
    desc: "Automatic stack trace decoding, DOM state snapshotting, and regression classification mapped directly to source commits.",
    badge: "ANALYTICS"
  },
  {
    title: "Enterprise Ecosystem Connectors",
    desc: "Native plugins for GitHub Actions, GitLab CI, Jenkins, Jira, Datadog, Slack, and enterprise SSO providers.",
    badge: "INTEGRATION"
  },
  {
    title: "Governance & Security",
    desc: "SOC 2-ready controls, fine-grained access policies, and encrypted data retention with customer-managed keys.",
    badge: "SECURITY"
  }
];
---

<Layout
  title="VERIQON ONE Platform Architecture — Enterprise Quality Engineering"
  description="Explore the VERIQON ONE Platform Architecture: a unified enterprise quality engineering platform developed by VERIQON TECHNOLOGIES connecting requirements to execution."
>
  <!-- Page Header -->
  <section class="platform-hero">
    <div class="container">
      <Breadcrumbs items={[{ label: 'Platform Architecture' }]} />
      
      <div class="badge badge-dark">
        <span class="badge-dot"></span> UNIFIED ENTERPRISE QUALITY ARCHITECTURE
      </div>
      <h1 class="heading-xl hero-title">
        The VERIQON ONE <br />
        <span class="gradient-text-light">Quality Engineering Platform</span>
      </h1>
      <p class="subheading subheading-dark hero-lead">
        Developed by <strong>VERIQON TECHNOLOGIES</strong>, VERIQON ONE unifies requirements ingestion, self-healing automation, ETL validation, performance, and security into a single deterministic operating fabric.
      </p>
    </div>
  </section>

  <!-- Live Platform Topology Console -->
  <section class="section" style="padding-top: 0; margin-top: -30px;">
    <div class="container">
      <StudioMockup
        studioName="Platform Topology Engine"
        stageBadge="UNIFIED QUALITY FABRIC"
        activeTab="Requirement Graph"
        codeSnippet={`// VERIQON ONE Core Architecture Engine Config
export interface VeriqonPlatformTopology {
  governance: "ZERO_TRUST_ENTERPRISE_RBAC";
  modelGateway: "PRIVATE_VPC_LOCAL_OR_DEDICATED_API";
  tenantIsolation: "STRICT_ROW_LEVEL_SECURITY";
  auditLedger: "CONTINUOUS_CRYPTOGRAPHIC_PERSISTENCE";
}`}
      />
    </div>
  </section>

  <!-- Four-Tier Architectural Fabric -->
  <section class="section section-alt">
    <div class="container">
      <div class="text-center section-header">
        <div class="eyebrow">
          <span class="badge-dot"></span> Platform Fabric
        </div>
        <h2 class="heading-lg">Four-Tier Quality Architecture</h2>
        <p class="subheading">
          Built upon modular, high-throughput enterprise services designed for predictability, security, and scalability.
        </p>
      </div>

      <div class="grid-2">
        {platformPillars.map((p) => (
          <div class="card">
            <div class="tier-num">{p.step}</div>
            <h3 class="heading-md" style="margin-top: 10px;">{p.title}</h3>
            <p style="color: var(--text-secondary); font-size: 14.5px; line-height: 1.7; margin-top: 8px;">
              {p.desc}
            </p>
            <div class="capability-tags">
              {p.capabilities.map((c) => (
                <span class="cap-tag">{c}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Core Capabilities Grid -->
  <section class="section">
    <div class="container">
      <div class="text-center section-header">
        <div class="eyebrow">
          <span class="badge-dot"></span> Core Modules
        </div>
        <h2 class="heading-lg">Complete Enterprise Quality Lifecycle</h2>
        <p class="subheading">
          Every component required to manage, execute, and govern enterprise test workloads at global scale.
        </p>
      </div>

      <div class="grid-3">
        {coreCapabilities.map((cap) => (
          <div class="card">
            <div class="badge-module">{cap.badge}</div>
            <h3 class="heading-md" style="margin-top: 12px;">{cap.title}</h3>
            <p style="color: var(--text-secondary); font-size: 14px; line-height: 1.65; margin-top: 8px;">
              {cap.desc}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <CtaSection
    title="Experience the VERIQON ONE Platform Architecture"
    subtitle="Connect with a VERIQON TECHNOLOGIES enterprise architect to review deployment models, VPC isolation, and integration topologies."
    primaryCtaText="Request a Demo"
    primaryCtaHref="/request-demo"
    secondaryCtaText="View Specialist Studios"
    secondaryCtaHref="/ai-studios"
  />
</Layout>

<style>
  .platform-hero {
    background: linear-gradient(180deg, #061B36 0%, #0A2547 100%);
    color: #FFFFFF;
    padding-top: 2rem;
    padding-bottom: 5rem;
  }

  .hero-title {
    color: #FFFFFF;
    margin-top: 1rem;
  }

  .hero-lead {
    margin-top: 1.25rem;
  }

  .tier-num {
    font-size: 18px;
    font-weight: 850;
    font-family: var(--font-mono);
    color: var(--royal-blue);
  }

  .capability-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 18px;
    padding-top: 14px;
    border-top: 1px solid var(--border-light);
  }

  .cap-tag {
    font-size: 11.5px;
    font-weight: 650;
    color: var(--royal-blue);
    background: rgba(8, 119, 232, 0.08);
    border: 1px solid rgba(8, 119, 232, 0.18);
    padding: 3px 10px;
    border-radius: 4px;
  }

  .badge-module {
    font-size: 10.5px;
    font-family: var(--font-mono);
    font-weight: 750;
    color: var(--cyan);
    background: #061B36;
    padding: 3px 8px;
    border-radius: 4px;
    display: inline-block;
  }
</style>
