---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaSection from '../components/CtaSection.astro';

const featureCategories = [
  {
    category: "AI & Autonomous Quality Reasoning",
    items: [
      { name: "Requirements Ingestion", desc: "Native parsing of PRDs, SRS docs, and Jira stories into verifiable acceptance models." },
      { name: "Multi-Modal Discovery", desc: "Analyzes DOM layouts, API endpoints, and database schemas simultaneously." },
      { name: "Configuration Plan Synthesis", desc: "Generates diffable, version-controlled execution plans before running tests." },
      { name: "Selector Self-Healing", desc: "Maintains test locator stability across dynamic UI updates and design system changes." }
    ]
  },
  {
    category: "Enterprise Governance & Security",
    items: [
      { name: "Zero-Trust RBAC", desc: "Strict role-based permissions separating viewers, QA engineers, and approval leads." },
      { name: "Tenant Isolation Auditing", desc: "Automated verification of database RLS policies and cross-tenant boundaries." },
      { name: "Cryptographic Audit Logs", desc: "Immutable trail of all test plans, execution evidence, and model interactions." },
      { name: "Private Local Model Support", desc: "Run models locally on private infrastructure via Ollama or custom gateways to safeguard sensitive IP." }
    ]
  },
  {
    category: "Execution & Tooling Integration",
    items: [
      { name: "Distributed Test Graph", desc: "Parallel run execution across isolated browser nodes and container clusters." },
      { name: "Continuous CI/CD Hooks", desc: "Lightweight CLI and webhook runners compatible with GitHub Actions and GitLab CI." },
      { name: "Rich Evidence Bundles", desc: "Automated video capture, step screenshots, network waterfalls, and console logs." },
      { name: "Zero Vendor Lock-In", desc: "Export suites to open standard Playwright, TypeScript, and SQL test scripts." }
    ]
  }
];
---

<Layout
  title="Enterprise Features & Architecture Capabilities | VERIQON ONE"
  description="Explore the complete VERIQON ONE Quality Engineering feature matrix. Built for enterprise resilience, security, and continuous automated verification by VERIQON TECHNOLOGIES."
>
  <div class="container" style="padding-top: 2.5rem;">
    <Breadcrumbs items={[{ label: 'Features' }]} />

    <header class="section-hero" style="padding-top: 1rem; padding-bottom: 3rem;">
      <div class="badge">
        <span class="badge-dot"></span> Complete Capability Matrix
      </div>
      <h1 class="heading-xl">Enterprise Engineering Features</h1>
      <p class="subheading">
        Every capability within VERIQON ONE is engineered to deliver deterministic test generation, reliable execution, and uncompromising enterprise security.
      </p>
    </header>

    <div class="features-grid">
      {featureCategories.map((cat) => (
        <section class="card feature-card">
          <div class="badge" style="margin-bottom: 1rem;">{cat.category}</div>
          <div class="feature-list">
            {cat.items.map((item) => (
              <div class="feature-item">
                <div class="feature-icon">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--royal-blue)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </div>
                <div class="feature-text">
                  <div class="feature-name">{item.name}</div>
                  <div class="feature-desc">{item.desc}</div>
                </div>
              </div>
            ))}
          </div>
        </section>
      ))}
    </div>

    <CtaSection
      title="Scale Quality Across Your Entire Enterprise"
      subtitle="Deploy VERIQON ONE across all engineering squads with centralized governance, shared test assets, and complete audit readiness."
      primaryCtaText="Request Platform Demo"
      primaryCtaHref="/request-demo"
      secondaryCtaText="Explore 7 Studios"
      secondaryCtaHref="/ai-studios"
    />
  </div>
</Layout>

<style>
  .features-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin-bottom: 5rem;
  }

  @media (min-width: 900px) {
    .features-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .feature-card {
    display: flex;
    flex-direction: column;
  }

  .feature-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-top: 1rem;
  }

  .feature-item {
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
  }

  .feature-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: var(--radius-sm);
    background: var(--ice-blue);
    border: 1px solid rgba(8, 119, 232, 0.15);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .feature-name {
    font-size: 15px;
    font-weight: 700;
    color: var(--brand-navy);
    margin-bottom: 4px;
  }

  .feature-desc {
    font-size: 13.5px;
    color: var(--text-secondary);
    line-height: 1.5;
  }
</style>
