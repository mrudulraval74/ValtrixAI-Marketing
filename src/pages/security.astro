---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaSection from '../components/CtaSection.astro';

const securityPillars = [
  {
    title: "Zero-Trust Isolation",
    desc: "Every testing studio, execution container, and database inspection node runs with granular RBAC, strictly scoped credentials, and multi-tenant isolation.",
    badge: "Architecture"
  },
  {
    title: "Air-Gapped & VPC Deployment",
    desc: "Deploy VERIQON ONE entirely within your private cloud (AWS, Azure, GCP) or on-premises Kubernetes cluster with zero external dependency.",
    badge: "Infrastructure"
  },
  {
    title: "Private AI Reasoning",
    desc: "Test generation and synthesis leverage dedicated enterprise AI models with strict zero-data-retention agreements or self-hosted local LLMs.",
    badge: "Data Protection"
  },
  {
    title: "Cryptographic Audit Trails",
    desc: "Every requirement change, synthesized test script, test run result, and approval is immutably signed and logged for compliance readiness.",
    badge: "Compliance"
  },
  {
    title: "Continuous Vulnerability Auditing",
    desc: "Built-in security studio actively evaluates OWASP Top 10, API authorization boundaries, and cross-tenant leakage in real time.",
    badge: "Verification"
  },
  {
    title: "Enterprise SSO & SAML 2.0",
    desc: "Seamless enterprise identity integration with Okta, Azure Active Directory / Entra ID, Ping Identity, and Google Workspace.",
    badge: "Identity"
  }
];
---

<Layout
  title="Security & Trust Architecture | VERIQON TECHNOLOGIES"
  description="Explore the enterprise security, zero-trust architecture, and compliance standards governing VERIQON ONE and VERIQON TECHNOLOGIES."
>
  <div class="container" style="padding-top: 2.5rem;">
    <Breadcrumbs items={[{ label: 'Security & Trust' }]} />

    <header class="section-hero" style="padding-top: 1rem; padding-bottom: 3.5rem;">
      <div class="badge">
        <span class="badge-dot"></span> Enterprise Security Architecture
      </div>
      <h1 class="heading-xl">Engineering Trust Through Uncompromising Security</h1>
      <p class="subheading">
        VERIQON ONE is engineered from the ground up for regulated industries requiring absolute data privacy, zero public telemetry, and complete tenant isolation.
      </p>
    </header>

    <div class="grid-3" style="margin-bottom: 5rem;">
      {securityPillars.map((pillar) => (
        <div class="card">
          <div class="badge" style="margin-bottom: 1rem; font-size: 11px;">{pillar.badge}</div>
          <h3 class="heading-md" style="margin-bottom: 0.75rem;">{pillar.title}</h3>
          <p style="color: var(--text-secondary); font-size: 14.5px; line-height: 1.6;">{pillar.desc}</p>
        </div>
      ))}
    </div>

    <!-- Security Model Details -->
    <section class="card" style="padding: 3rem; margin-bottom: 5rem; background: linear-gradient(135deg, rgba(8, 119, 232, 0.04) 0%, rgba(8, 197, 232, 0.02) 100%);">
      <div class="badge" style="margin-bottom: 1rem;">Data Flow Security</div>
      <h2 class="heading-lg" style="margin-bottom: 1rem;">How VERIQON ONE Safeguards Proprietary Code and Data</h2>
      <p style="color: var(--text-secondary); max-width: 800px; line-height: 1.7; margin-bottom: 2rem;">
        Unlike generic developer tools that pipe proprietary application code through shared public AI endpoints, VERIQON ONE treats your codebase and test fixtures as critical intellectual property.
      </p>

      <div class="grid-3">
        <div style="padding: 1.5rem; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-md);">
          <h4 style="font-size: 16px; font-weight: 700; color: var(--brand-navy); margin-bottom: 8px;">1. Client-Side Sanitization</h4>
          <p style="font-size: 13.5px; color: var(--text-secondary); line-height: 1.5;">Personal data, credentials, and secrets are automatically masked before any AST or schema modeling occurs.</p>
        </div>
        <div style="padding: 1.5rem; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-md);">
          <h4 style="font-size: 16px; font-weight: 700; color: var(--brand-navy); margin-bottom: 8px;">2. Isolated Workspaces</h4>
          <p style="font-size: 13.5px; color: var(--text-secondary); line-height: 1.5;">Every enterprise tenant operates with independent cryptographic keying, dedicated database schemas, and isolated worker nodes.</p>
        </div>
        <div style="padding: 1.5rem; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-md);">
          <h4 style="font-size: 16px; font-weight: 700; color: var(--brand-navy); margin-bottom: 8px;">3. Signed Execution Bundles</h4>
          <p style="font-size: 13.5px; color: var(--text-secondary); line-height: 1.5;">Execution runs generate tamper-evident audit packages with timestamped artifacts for SOC 2 and ISO 27001 readiness.</p>
        </div>
      </div>
    </section>

    <CtaSection
      title="Discuss Your Enterprise Security Requirements"
      subtitle="Connect directly with our security architects to review architecture diagrams, compliance certifications, and deployment models."
      primaryCtaText="Request Security Review"
      primaryCtaHref="/contact"
      secondaryCtaText="Read Enterprise Architecture"
      secondaryCtaHref="/enterprise"
    />
  </div>
</Layout>
