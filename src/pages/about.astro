---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaSection from '../components/CtaSection.astro';

const coreValues = [
  {
    title: "Deterministic Rigor",
    desc: "We reject probabilistic flakiness in critical infrastructure. Quality software demands mathematical certainty, reproducible execution, and unwavering test determinism."
  },
  {
    title: "Zero-Trust Engineering",
    desc: "Data privacy, multi-tenant perimeter isolation, and immutable cryptographic audit trails are non-negotiable architectural mandates in everything we construct."
  },
  {
    title: "Respect for Operating Constraints",
    desc: "We engineer software that flourishes inside real-world enterprise environments—incorporating air-gapped VPCs, legacy core migrations, and complex compliance frameworks."
  },
  {
    title: "Continuous Innovation",
    desc: "We combine cutting-edge artificial intelligence, multi-modal reasoning, and self-healing algorithms to automate routine toil and empower engineering minds."
  }
];

const milestones = [
  {
    phase: "FOUNDATION",
    title: "The Problem of Fragmented QA",
    desc: "Formed by senior systems architects and quality engineers who recognized that enterprise release cycles were fundamentally throttled by brittle scripts and disconnected tools."
  },
  {
    phase: "INNOVATION",
    title: "The Creation of VERIQON ONE",
    desc: "Architected a unified quality engineering operating fabric connecting requirements ingestion, self-healing automation, data warehouse integrity, and continuous security."
  },
  {
    phase: "GLOBAL IMPACT",
    title: "Enterprise Quality Sovereignty",
    desc: "Empowering mission-critical enterprises across banking, healthcare, telecom, and SaaS to deploy software with verified, deterministic release confidence."
  }
];
---

<Layout
  title="About Us — VERIQON TECHNOLOGIES"
  description="Discover VERIQON TECHNOLOGIES: our mission, core philosophy, and why we believe software quality should be engineered from the beginning, not inspected at the end."
>
  <section class="about-hero">
    <div class="container text-center">
      <Breadcrumbs items={[{ label: 'About Us' }]} />

      <div class="badge badge-dark">
        <span class="badge-dot"></span> CORPORATE IDENTITY &amp; MISSION
      </div>
      <h1 class="heading-xl hero-title">
        Engineering Trust <br />
        <span class="gradient-text-light">Through Intelligence.</span>
      </h1>
      <p class="subheading subheading-dark hero-lead">
        VERIQON TECHNOLOGIES is an enterprise technology organisation dedicated to intelligent engineering, quality determinism, and software reliability at global scale.
      </p>
    </div>
  </section>

  <!-- Core Philosophy Section -->
  <section class="section">
    <div class="container" style="max-width: 960px;">
      <div class="philosophy-card text-center">
        <span class="philo-eyebrow">OUR CORE PHILOSOPHY</span>
        <blockquote class="philo-quote">
          &ldquo;We believe quality should be engineered from the beginning, not inspected at the end.&rdquo;
        </blockquote>
        <p class="philo-text">
          Traditional software delivery treats quality assurance as a frantic, late-stage gatekeeper—a manual inspection bottleneck bolted onto the end of a sprint. At VERIQON TECHNOLOGIES, we believe true quality is structural. It begins the instant a business requirement is formulated and persists continuously through deployment, data flow, and runtime operations.
        </p>
      </div>
    </div>
  </section>

  <!-- Brand Architecture & Product Relationship -->
  <section class="section section-alt">
    <div class="container">
      <div class="text-center section-header">
        <div class="eyebrow">
          <span class="badge-dot"></span> Brand Architecture
        </div>
        <h2 class="heading-lg">The Parent Company &amp; Flagship Platform</h2>
        <p class="subheading">
          Understanding the governance relationship between VERIQON TECHNOLOGIES and VERIQON ONE.
        </p>
      </div>

      <div class="grid-2">
        <div class="card brand-card">
          <div class="brand-card-header">
            <span class="entity-type">PARENT COMPANY</span>
            <h3 class="heading-md" style="margin-top: 6px;">VERIQON TECHNOLOGIES</h3>
          </div>
          <p style="color: var(--text-secondary); font-size: 14px; line-height: 1.7; margin-top: 12px;">
            The parent technology organisation representing corporate governance, fundamental research in software verification, institutional partnerships, and global enterprise advisory.
          </p>
          <ul class="entity-list">
            <li>Enterprise research &amp; mathematical determinism</li>
            <li>Zero-trust security and compliance standards</li>
            <li>Corporate governance &amp; global institutional briefings</li>
          </ul>
        </div>

        <div class="card brand-card brand-card-product">
          <div class="brand-card-header">
            <span class="entity-type" style="color: var(--cyan);">FLAGSHIP PLATFORM</span>
            <h3 class="heading-md" style="margin-top: 6px; color: #FFFFFF;">VERIQON ONE</h3>
          </div>
          <p style="color: #C7D0DA; font-size: 14px; line-height: 1.7; margin-top: 12px;">
            The comprehensive Enterprise Quality Engineering Platform developed, licensed, and maintained by VERIQON TECHNOLOGIES. Houses the 7 specialist testing studios.
          </p>
          <ul class="entity-list entity-list-light">
            <li>7 Specialist Testing Studios in one unified console</li>
            <li>Self-healing test automation &amp; predictive performance</li>
            <li>Data warehouse reconciliation &amp; continuous DAST security</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Company Journey / Milestones -->
  <section class="section" style="background: var(--surface-subtle); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border);">
    <div class="container">
      <div class="text-center section-header">
        <div class="eyebrow">
          <span class="badge-dot"></span> Evolution &amp; Trajectory
        </div>
        <h2 class="heading-lg">Our Journey to Enterprise Quality Engineering</h2>
        <p class="subheading">
          Built from first-principles engineering experience to solve the enterprise quality crisis.
        </p>
      </div>

      <div class="grid-3">
        {milestones.map((m) => (
          <div class="card">
            <div class="badge" style="margin-bottom: 1rem; font-size: 11px;">{m.phase}</div>
            <h3 class="heading-md" style="margin-bottom: 0.75rem;">{m.title}</h3>
            <p style="color: var(--text-secondary); font-size: 14px; line-height: 1.7;">{m.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Core Values Grid -->
  <section class="section">
    <div class="container">
      <div class="text-center section-header">
        <div class="eyebrow">
          <span class="badge-dot"></span> Values &amp; Principles
        </div>
        <h2 class="heading-lg">Principles That Guide Our Engineering</h2>
        <p class="subheading">
          The non-negotiable architectural tenets reflected in every line of code we ship.
        </p>
      </div>

      <div class="grid-2">
        {coreValues.map((v) => (
          <div class="card">
            <h3 class="heading-md" style="color: var(--royal-blue);">{v.title}</h3>
            <p style="color: var(--text-secondary); font-size: 14px; line-height: 1.7; margin-top: 8px;">
              {v.desc}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <CtaSection
    title="Partner with VERIQON TECHNOLOGIES"
    subtitle="Learn how our engineering team can help your organisation establish deterministic quality standards."
    primaryCtaText="Request a Demo"
    primaryCtaHref="/request-demo"
    secondaryCtaText="Contact Sales"
    secondaryCtaHref="/contact"
  />
</Layout>

<style>
  .about-hero {
    background: linear-gradient(180deg, #061B36 0%, #0A2547 100%);
    color: #FFFFFF;
    padding-top: 2rem;
    padding-bottom: 5rem;
  }

  .hero-title {
    color: #FFFFFF;
    margin-top: 1rem;
  }

  .hero-lead {
    margin-top: 1.25rem;
    margin-inline: auto;
  }

  /* Philosophy Card */
  .philosophy-card {
    background: #FFFFFF;
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    padding: clamp(36px, 5vw, 64px);
    position: relative;
    overflow: hidden;
  }

  .philosophy-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--royal-blue), var(--cyan));
  }

  .philo-eyebrow {
    font-size: 11px;
    font-family: var(--font-mono);
    font-weight: 750;
    letter-spacing: 0.15em;
    color: var(--royal-blue);
    display: block;
    margin-bottom: 1rem;
  }

  .philo-quote {
    font-size: clamp(22px, 3.2vw, 34px);
    font-weight: 800;
    line-height: 1.3;
    letter-spacing: -0.025em;
    color: var(--text-primary);
    max-width: 820px;
    margin-inline: auto;
  }

  .philo-text {
    margin-top: 1.5rem;
    font-size: 15.5px;
    line-height: 1.75;
    color: var(--text-secondary);
    max-width: 760px;
    margin-inline: auto;
  }

  /* Brand Cards */
  .brand-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .brand-card-product {
    background: #0A2547;
    border-color: rgba(8, 197, 232, 0.35);
  }

  .entity-type {
    font-size: 11px;
    font-family: var(--font-mono);
    font-weight: 750;
    letter-spacing: 0.1em;
    color: var(--royal-blue);
  }

  .entity-list {
    margin-top: 16px;
    padding-top: 14px;
    border-top: 1px solid var(--border-light);
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 13.5px;
    color: var(--text-primary);
  }

  .entity-list-light {
    border-color: rgba(255, 255, 255, 0.1);
    color: #E8EEF5;
  }

  .entity-list li::before {
    content: "•";
    color: var(--cyan);
    font-weight: bold;
    display: inline-block;
    width: 1em;
    margin-left: -1em;
  }
</style>
