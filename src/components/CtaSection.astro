---
interface Props {
  title?: string;
  subtitle?: string;
  primaryCtaText?: string;
  primaryCtaHref?: string;
  secondaryCtaText?: string;
  secondaryCtaHref?: string;
}

const {
  title = "Want to see the platform in context?",
  subtitle = "Request a walkthrough of the monitored workflow or quality engineering studio most relevant to your team.",
  primaryCtaText = "Request Monitored Walkthrough",
  primaryCtaHref = "/contact",
  secondaryCtaText = "Explore Platform Architecture",
  secondaryCtaHref = "/platform"
} = Astro.props;
---

<section class="section cta-section">
  <div class="container">
    <div class="card cta-card">
      <div class="eyebrow" style="margin-inline: auto;">
        <span class="badge-dot"></span> Governed Intelligence
      </div>
      <h2 class="title" style="font-size: clamp(30px, 4vw, 48px);">{title}</h2>
      <p class="copy" style="margin-inline: auto;">{subtitle}</p>
      
      <div class="btn-row" style="justify-content: center;">
        <a href={primaryCtaHref} class="btn btn-primary">{primaryCtaText}</a>
        <a href={secondaryCtaHref} class="btn btn-secondary">{secondaryCtaText}</a>
      </div>

      <div class="cta-tags">
        <span>Zero-Trust Architecture</span>
        &bull;
        <span>Local &amp; Private Model Execution</span>
        &bull;
        <span>Immutable Audit Records</span>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-section {
    padding-top: 2rem;
    padding-bottom: 5rem;
  }

  .cta-card {
    text-align: center;
    background: radial-gradient(circle at 50% 0%, rgba(97, 173, 255, 0.12), rgba(157, 125, 255, 0.08) 50%, rgba(7, 17, 29, 0.8) 100%);
    border: 1px solid var(--stroke-strong);
    padding: clamp(48px, 6vw, 84px) clamp(24px, 4vw, 48px);
  }

  .cta-tags {
    margin-top: 36px;
    font-size: 13px;
    color: var(--muted2);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }
</style>
