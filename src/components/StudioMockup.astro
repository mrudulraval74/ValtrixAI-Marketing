---
interface Props {
  studioName?: string;
  stageBadge?: string;
  activeTab?: string;
  defaultTab?: 'lifecycle' | 'execution' | 'traceability' | 'defects' | 'knowledge';
  executionMetrics?: { label: string; value: string; status?: 'pass' | 'warn' | 'info' | string }[];
  codeSnippet?: string;
}

const {
  studioName = "Unified Platform Console",
  stageBadge = "ENTERPRISE RUNTIME",
  activeTab = "Quality Lifecycle",
  defaultTab = "lifecycle",
  executionMetrics = [
    { label: "Deterministic Quality Score", value: "99.8%", status: "pass" },
    { label: "P99 Execution Latency", value: "32ms", status: "info" },
    { label: "Zero-Trust Policy Adherence", value: "100.0%", status: "pass" }
  ],
  codeSnippet
} = Astro.props;
---

<div class="mockup-window" role="region" aria-label="VERIQON ONE Platform Console Preview" data-default-tab={defaultTab}>
  <!-- Top Application Bar (Faithful to real VERIQON ONE software) -->
  <div class="mockup-topbar">
    <div class="topbar-left">
      <div class="window-controls" aria-hidden="true">
        <span class="window-dot dot-red"></span>
        <span class="window-dot dot-yellow"></span>
        <span class="window-dot dot-green"></span>
      </div>
      <div class="brand-divider"></div>
      <div class="app-identity">
        <svg class="topbar-emblem" width="22" height="22" viewBox="0 0 100 100" fill="none">
          <path d="M12 20 L35 76 L52 40 L35 20 Z" fill="#0877E8"/>
          <path d="M42 20 L60 56 L68 40 L58 20 Z" fill="#08C5E8"/>
          <path d="M52 20 L78 20 L88 38 L76 56 L64 56 L72 40 Z" fill="#C7D0DA"/>
          <path d="M60 56 L78 80 L62 80 L48 62 Z" fill="#08C5E8"/>
        </svg>
        <span class="app-name">VERIQON ONE</span>
        <span class="app-studio-tag">&bull; {studioName}</span>
        <span class="app-workspace">Default Workspace &bull; Primary Project</span>
      </div>
    </div>

    <div class="topbar-center">
      <div class="topbar-search">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <span>Search requirements, test cases, studios...</span>
        <kbd>Ctrl K</kbd>
      </div>
    </div>

    <div class="topbar-right">
      <div class="status-indicator">
        <span class="pulse-dot"></span>
        <span>AI Engine Active</span>
      </div>
      <span class="badge-stage">{stageBadge}</span>
    </div>
  </div>

  <!-- Interactive Platform Sub-navigation Tabs -->
  <div class="mockup-nav-tabs" role="tablist">
    <button type="button" class="tab-btn active" data-tab="lifecycle" role="tab" aria-selected="true">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="3" y="3" width="7" height="7"></rect>
        <rect x="14" y="3" width="7" height="7"></rect>
        <rect x="14" y="14" width="7" height="7"></rect>
        <rect x="3" y="14" width="7" height="7"></rect>
      </svg>
      <span>Quality Lifecycle</span>
    </button>
    <button type="button" class="tab-btn" data-tab="execution" role="tab" aria-selected="false">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polygon points="5 3 19 12 5 21 5 3"></polygon>
      </svg>
      <span>Execution Center</span>
      <span class="tab-counter">12 Nodes</span>
    </button>
    <button type="button" class="tab-btn" data-tab="traceability" role="tab" aria-selected="false">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="18" y1="20" x2="18" y2="10"></line>
        <line x1="12" y1="20" x2="12" y2="4"></line>
        <line x1="6" y1="20" x2="6" y2="14"></line>
      </svg>
      <span>Traceability &amp; Coverage</span>
    </button>
    <button type="button" class="tab-btn" data-tab="defects" role="tab" aria-selected="false">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="4" y="4" width="16" height="16" rx="2"></rect>
        <path d="M9 9h6v6H9z"></path>
      </svg>
      <span>Defect Management</span>
    </button>
    <button type="button" class="tab-btn" data-tab="knowledge" role="tab" aria-selected="false">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
        <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
      </svg>
      <span>Knowledge Hub &amp; RAG</span>
    </button>
  </div>

  <!-- TAB PANELS -->
  <div class="mockup-content">
    
    <!-- 1. QUALITY LIFECYCLE (Real App Screen Rebranded) -->
    <div class="tab-panel active" id="panel-lifecycle" role="tabpanel">
      <div class="panel-header-banner">
        <div>
          <div class="banner-eyebrow">AUTONOMOUS QUALITY ENGINEERING LIFECYCLE</div>
          <h3 class="banner-title">Deterministic 5-Stage Verification Fabric</h3>
        </div>
        <div class="banner-stats">
          {executionMetrics.map((m) => (
            <span class="stat-pill">
              <strong style={`color: ${m.status === 'pass' ? 'var(--cyan)' : '#61adff'}`}>{m.value}</strong> {m.label}
            </span>
          ))}
        </div>
      </div>

      <div class="lifecycle-steps-grid">
        <!-- Step 1 -->
        <div class="lifecycle-step-card">
          <div class="step-num-badge">STEP 01</div>
          <div class="step-icon-wrap" style="color: var(--royal-blue); background: rgba(8, 119, 232, 0.12);">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
            </svg>
          </div>
          <h4 class="step-title">Specify &amp; Ingest</h4>
          <p class="step-sub">Requirements &amp; User Stories</p>
          <div class="step-footer">
            <span class="step-val">42 Tracked</span>
            <span class="step-badge-ready">Active Sync</span>
          </div>
        </div>

        <!-- Step 2 -->
        <div class="lifecycle-step-card step-highlight">
          <div class="step-num-badge" style="color: var(--cyan);">STEP 02 &bull; AI FLAGSHIP</div>
          <div class="step-icon-wrap" style="color: var(--cyan); background: rgba(8, 197, 232, 0.15);">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
            </svg>
          </div>
          <h4 class="step-title">AI Synthesis</h4>
          <p class="step-sub">Autonomous Test Modeling</p>
          <div class="step-footer">
            <span class="step-val" style="color: var(--cyan);">1,420 Generated</span>
            <span class="step-badge-ai">Ollama / Private LLM</span>
          </div>
        </div>

        <!-- Step 3 -->
        <div class="lifecycle-step-card">
          <div class="step-num-badge">STEP 03</div>
          <div class="step-icon-wrap" style="color: #10b981; background: rgba(16, 185, 129, 0.12);">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="3" width="18" height="18" rx="2"></rect>
              <path d="m9 12 2 2 4-4"></path>
            </svg>
          </div>
          <h4 class="step-title">Plan &amp; Structure</h4>
          <p class="step-sub">Suites &amp; Traceability</p>
          <div class="step-footer">
            <span class="step-val">48 Test Suites</span>
            <span class="step-badge-ready">Plan Ready</span>
          </div>
        </div>

        <!-- Step 4 -->
        <div class="lifecycle-step-card">
          <div class="step-num-badge">STEP 04</div>
          <div class="step-icon-wrap" style="color: #f59e0b; background: rgba(245, 158, 11, 0.12);">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <polygon points="10 8 16 12 10 16 10 8"></polygon>
            </svg>
          </div>
          <h4 class="step-title">Execute &amp; Monitor</h4>
          <p class="step-sub">Execution Center &amp; Workers</p>
          <div class="step-footer">
            <span class="step-val">12 Active Nodes</span>
            <span class="step-badge-ready">Queue Live</span>
          </div>
        </div>

        <!-- Step 5 -->
        <div class="lifecycle-step-card">
          <div class="step-num-badge">STEP 05</div>
          <div class="step-icon-wrap" style="color: #08C5E8; background: rgba(8, 197, 232, 0.12);">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
          </div>
          <h4 class="step-title">Triage &amp; Protect</h4>
          <p class="step-sub">AI Root Cause &amp; Defense</p>
          <div class="step-footer">
            <span class="step-val" style="color: #10b981;">99.8% Pass Rate</span>
            <span class="step-badge-ready">Audit Clean</span>
          </div>
        </div>
      </div>

      <!-- Real-time Console Telemetry Feed -->
      <div class="console-stream-box">
        <div class="stream-header">
          <span class="stream-tag">LIVE SYNTHESIS TOPOLOGY &bull; {activeTab}</span>
          <span class="stream-ts">Timestamp: 2026-11-14 22:18:40 UTC</span>
        </div>
        {codeSnippet && (
          <pre class="studio-code-snippet" style="background: rgba(10, 37, 71, 0.7); border: 1px solid rgba(8, 197, 232, 0.25); border-radius: 6px; padding: 12px; margin-bottom: 12px; color: #E2E8F0; font-family: var(--font-mono); font-size: 11.5px; overflow-x: auto; line-height: 1.5;"><code>{codeSnippet}</code></pre>
        )}
        <div class="stream-code">
          <code><span class="c-cyan">&gt; [Ingestion]</span> Parsed 42 enterprise PRD epics from Jira / Confluence gateway. Zero orphan requirements.</code>
          <code><span class="c-blue">&gt; [Synthesis]</span> Synthesized 1,420 deterministic test cases across 7 specialist studios.</code>
          <code><span class="c-green">&gt; [Self-Healing]</span> DOM locator drift detected on checkout button &mdash; auto-repaired in 14ms using semantic AST embeddings.</code>
          <code><span class="c-cyan">&gt; [Security]</span> PostgreSQL RLS boundary audit completed: 100% tenant isolation verified across all schemas.</code>
        </div>
      </div>
    </div>

    <!-- 2. UNIFIED EXECUTION CENTER -->
    <div class="tab-panel" id="panel-execution" role="tabpanel">
      <div class="execution-kpis">
        <div class="kpi-box">
          <div class="kpi-label">TOTAL EXECUTIONS</div>
          <div class="kpi-value">12,480</div>
          <div class="kpi-delta">+1,420 today</div>
        </div>
        <div class="kpi-box">
          <div class="kpi-label">QUEUE DEPTH</div>
          <div class="kpi-value" style="color: var(--cyan);">0</div>
          <div class="kpi-delta">Real-time throughput</div>
        </div>
        <div class="kpi-box">
          <div class="kpi-label">ACTIVE RUNNER NODES</div>
          <div class="kpi-value" style="color: #61adff;">12 Online</div>
          <div class="kpi-delta">Kubernetes Auto-scale</div>
        </div>
        <div class="kpi-box">
          <div class="kpi-label">PASS RATE</div>
          <div class="kpi-value" style="color: #10b981;">99.64%</div>
          <div class="kpi-delta">Zero flaky failures</div>
        </div>
        <div class="kpi-box">
          <div class="kpi-label">P99 LATENCY</div>
          <div class="kpi-value">32ms</div>
          <div class="kpi-delta">Air-gapped runtime</div>
        </div>
      </div>

      <div class="execution-grid-details">
        <div class="sub-panel">
          <div class="sub-panel-title">SPECIALIST STUDIO RUNNERS DISPATCHED</div>
          <div class="studio-status-rows">
            <div class="studio-row">
              <span class="st-dot dot-active"></span>
              <span class="st-name">Automation Studio</span>
              <span class="st-tech">Chromium &bull; WebKit &bull; Firefox</span>
              <span class="st-runs">3,480 runs</span>
              <span class="st-badge badge-pass">PASSED</span>
            </div>
            <div class="studio-row">
              <span class="st-dot dot-active"></span>
              <span class="st-name">API Testing Studio</span>
              <span class="st-tech">REST &bull; GraphQL &bull; gRPC</span>
              <span class="st-runs">5,120 contracts</span>
              <span class="st-badge badge-pass">PASSED</span>
            </div>
            <div class="studio-row">
              <span class="st-dot dot-active"></span>
              <span class="st-name">ETL / Data Testing</span>
              <span class="st-tech">PostgreSQL &bull; Snowflake &bull; DuckDB</span>
              <span class="st-runs">1,890 diffs</span>
              <span class="st-badge badge-pass">PASSED</span>
            </div>
            <div class="studio-row">
              <span class="st-dot dot-active"></span>
              <span class="st-name">Security Testing Studio</span>
              <span class="st-tech">DAST &bull; OWASP Top 10 &bull; RLS Guard</span>
              <span class="st-runs">940 policies</span>
              <span class="st-badge badge-pass">PASSED</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- 3. TRACEABILITY & COVERAGE -->
    <div class="tab-panel" id="panel-traceability" role="tabpanel">
      <div class="trace-metrics-row">
        <div class="trace-card">
          <div class="trace-label">REQUIREMENT COVERAGE</div>
          <div class="trace-score" style="color: var(--cyan);">98.6%</div>
          <div class="trace-sub">Target: 95.0% &bull; +3.6% ahead</div>
        </div>
        <div class="trace-card">
          <div class="trace-label">USER STORY COVERAGE</div>
          <div class="trace-score" style="color: #61adff;">99.2%</div>
          <div class="trace-sub">124 of 125 INVEST stories</div>
        </div>
        <div class="trace-card">
          <div class="trace-label">TRACEABILITY INTEGRITY</div>
          <div class="trace-score" style="color: #10b981;">100%</div>
          <div class="trace-sub">Orphan-free &bull; Zero stale specs</div>
        </div>
        <div class="trace-card">
          <div class="trace-label">UNCOVERED CRITERIA GAPS</div>
          <div class="trace-score" style="color: var(--silver);">0</div>
          <div class="trace-sub">Resolved automatically by AI</div>
        </div>
      </div>

      <div class="matrix-preview-card">
        <div class="matrix-header">
          <span>REQUIREMENT-TO-VERIFICATION TRACEABILITY MATRIX</span>
          <span class="badge-tag">ISO 26262 &bull; SOC 2 READINESS</span>
        </div>
        <div class="matrix-table-wrap">
          <table class="matrix-table">
            <thead>
              <tr>
                <th>Req ID</th>
                <th>Requirement Description</th>
                <th>Linked User Story</th>
                <th>Automated Test Cases</th>
                <th>Verification Studio</th>
                <th>Compliance Status</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><code>REQ-AUTH-001</code></td>
                <td>Zero-Trust Multi-Tenant Session Isolation</td>
                <td>US-849: SAML / Okta SSO</td>
                <td>TC-E2E-104, TC-SEC-012</td>
                <td>Security Studio</td>
                <td><span class="badge-pass">VERIFIED</span></td>
              </tr>
              <tr>
                <td><code>REQ-DATA-042</code></td>
                <td>Financial Settlement Double-Entry Ledger</td>
                <td>US-855: Ledger Sync</td>
                <td>TC-ETL-401, TC-ETL-402</td>
                <td>ETL &amp; Data Studio</td>
                <td><span class="badge-pass">VERIFIED</span></td>
              </tr>
              <tr>
                <td><code>REQ-PERF-019</code></td>
                <td>Sub-50ms API Latency at 50,000 req/sec</td>
                <td>US-862: Gateway Throughput</td>
                <td>TC-PERF-881, TC-API-204</td>
                <td>Performance Studio</td>
                <td><span class="badge-pass">VERIFIED</span></td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- 4. DEFECT MANAGEMENT & AI TRIAGE -->
    <div class="tab-panel" id="panel-defects" role="tabpanel">
      <div class="defect-triage-layout">
        <div class="defect-filters">
          <span class="defect-pill active">All Categories (14)</span>
          <span class="defect-pill">Functional (0)</span>
          <span class="defect-pill">ETL Pipeline (0)</span>
          <span class="defect-pill">Security (0)</span>
          <span class="defect-pill">Performance (0)</span>
          <span class="defect-pill">Automation Self-Healed (14)</span>
        </div>

        <div class="triage-card">
          <div class="triage-head">
            <span class="triage-status">AI ROOT CAUSE TRIAGE &bull; AUTO-REPAIRED</span>
            <span class="triage-time">Resolved in 18ms</span>
          </div>
          <h4 class="triage-title">Dynamic UI Shadow-DOM Locator Shift Detected</h4>
          <p class="triage-body">
            Target selector <code>#btn-checkout-v2</code> changed attributes during continuous deployment. VERIQON ONE Autonomous Synthesis engine inferred semantic equivalence from surrounding accessibility labels and automatically updated the test script without engineer intervention.
          </p>
          <div class="triage-meta">
            <span><strong>Impact:</strong> Zero build downtime</span>
            <span><strong>Confidence:</strong> 99.8% match</span>
            <span><strong>Origin:</strong> Automation Studio</span>
          </div>
        </div>
      </div>
    </div>

    <!-- 5. KNOWLEDGE HUB & RAG CONNECTORS -->
    <div class="tab-panel" id="panel-knowledge" role="tabpanel">
      <div class="rag-status-grid">
        <div class="rag-card">
          <div class="rag-label">VECTOR INDEX STATUS</div>
          <div class="rag-val" style="color: #10b981;">INDEXED &bull; 100%</div>
          <div class="rag-desc">Continuous semantic synchronization</div>
        </div>
        <div class="rag-card">
          <div class="rag-label">EMBEDDING MODEL</div>
          <div class="rag-val" style="color: var(--cyan);">text-embedding-004</div>
          <div class="rag-desc">Dedicated private enterprise endpoint</div>
        </div>
        <div class="rag-card">
          <div class="rag-label">HYBRID SEARCH</div>
          <div class="rag-val" style="color: #61adff;">ENABLED</div>
          <div class="rag-desc">BM25 keyword + Cosine vector distance</div>
        </div>
        <div class="rag-card">
          <div class="rag-label">ENTERPRISE CONNECTORS</div>
          <div class="rag-val">Jira &bull; Azure DevOps &bull; GitHub</div>
          <div class="rag-desc">Zero manual file exports required</div>
        </div>
      </div>
    </div>

  </div>
</div>

<script>
  // Client-side lightweight tab switcher
  document.addEventListener('DOMContentLoaded', () => {
    const tabButtons = document.querySelectorAll('.mockup-nav-tabs .tab-btn');
    const tabPanels = document.querySelectorAll('.mockup-content .tab-panel');

    tabButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetTab = btn.getAttribute('data-tab');
        if (!targetTab) return;

        tabButtons.forEach((b) => {
          b.classList.remove('active');
          b.setAttribute('aria-selected', 'false');
        });
        tabPanels.forEach((p) => p.classList.remove('active'));

        btn.classList.add('active');
        btn.setAttribute('aria-selected', 'true');

        const activePanel = document.getElementById(`panel-${targetTab}`);
        if (activePanel) {
          activePanel.classList.add('active');
        }
      });
    });

    // Auto-activate defaultTab if set
    const defaultTabName = document.querySelector('.mockup-window')?.getAttribute('data-default-tab');
    if (defaultTabName && defaultTabName !== 'lifecycle') {
      const targetBtn = document.querySelector(`.mockup-nav-tabs .tab-btn[data-tab="${defaultTabName}"]`) as HTMLButtonElement | null;
      if (targetBtn) {
        targetBtn.click();
      }
    }
  });
</script>

<style>
  .mockup-window {
    background: #061B36;
    border: 1px solid rgba(8, 197, 232, 0.35);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: 0 25px 60px rgba(6, 27, 54, 0.55);
    margin-top: 2rem;
    margin-bottom: 2rem;
    text-align: left;
  }

  .mockup-topbar {
    background: #0A2547;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding: 12px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .topbar-left {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .window-controls {
    display: flex;
    gap: 6px;
  }

  .window-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .dot-red { background: #ff5f56; }
  .dot-yellow { background: #ffbd2e; }
  .dot-green { background: #27c93f; }

  .brand-divider {
    width: 1px;
    height: 20px;
    background: rgba(255, 255, 255, 0.15);
  }

  .app-identity {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .topbar-emblem {
    flex-shrink: 0;
  }

  .app-name {
    font-size: 13.5px;
    font-weight: 750;
    color: #FFFFFF;
    letter-spacing: -0.01em;
  }

  .app-studio-tag {
    font-size: 13px;
    font-weight: 700;
    color: var(--cyan);
  }

  .app-workspace {
    font-size: 11.5px;
    color: #94A3B8;
    background: rgba(255, 255, 255, 0.05);
    padding: 2px 8px;
    border-radius: 4px;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .topbar-center {
    flex: 1;
    max-width: 440px;
  }

  .topbar-search {
    background: rgba(6, 27, 54, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-sm);
    padding: 6px 12px;
    display: flex;
    align-items: center;
    gap: 8px;
    color: #94A3B8;
    font-size: 12px;
  }

  .topbar-search kbd {
    margin-left: auto;
    font-size: 10px;
    font-family: var(--font-mono);
    background: rgba(255, 255, 255, 0.1);
