---
interface Props {
  studioName: string;
  stageBadge?: string;
  activeTab?: string;
  executionMetrics?: { label: string; value: string; status?: 'pass' | 'warn' | 'info' }[];
  codeSnippet?: string;
}

const {
  studioName = "AI End-to-End Studio",
  stageBadge = "OPERATIONAL CONSOLE",
  activeTab = "Risk & Exposure",
  executionMetrics = [
    { label: "Active Monitored Streams", value: "14 Live", status: "pass" },
    { label: "Verification Latency", value: "28ms p99", status: "info" },
    { label: "Model Policy Adherence", value: "100.0%", status: "pass" }
  ],
  codeSnippet = `// Monitored Workflow Review & Routing Logic
const evaluation = await valtrix.evaluateMonitoredStream({
  streamId: "FIN-PORTFOLIO-ALERT-091",
  domain: "CAPITAL_RISK_EXPOSURE",
  governance: "GOVERNED_HUMAN_IN_THE_LOOP_REVIEW"
});`
} = Astro.props;
---

<div class="mockup-window glass" role="region" aria-label={`${studioName} Console Preview`}>
  <div class="mockup-header">
    <div class="window-controls" aria-hidden="true">
      <span class="window-dot dot-red"></span>
      <span class="window-dot dot-yellow"></span>
      <span class="window-dot dot-green"></span>
    </div>
    <div class="mockup-title">
      <span>Valtrix AI Console</span> &bull; <span>{studioName}</span>
    </div>
    <div class="mockup-badge">
      {stageBadge}
    </div>
  </div>

  <div class="console-body">
    <!-- Console Tab Bar -->
    <div class="console-subbar">
      <div class="tab-list">
        <button type="button" class={`console-tab ${activeTab === 'Risk & Exposure' ? 'active' : ''}`}>{activeTab}</button>
        <button type="button" class="console-tab">Operator Queue</button>
        <button type="button" class="console-tab">Traceability Graph</button>
        <button type="button" class="console-tab">Audit History</button>
      </div>
      <div class="live-stream-status">
        <span class="status-pulse"></span> Telemetry Synchronized
      </div>
    </div>

    <!-- Main Console Grid -->
    <div class="console-grid">
      <!-- Left: Engine Execution & Code -->
      <div class="console-pane">
        <div class="pane-tag">WORKFLOW SYNTHESIS SPECIFICATION</div>
        <pre class="code-box"><code><span class="code-comment">{codeSnippet}</span></code></pre>

        <!-- KPI Metrics Row -->
        <div class="metrics-row">
          {executionMetrics.map((m) => (
            <div class="metric-card">
              <span class="metric-lbl">{m.label}</span>
              <span class={`metric-val val-${m.status || 'info'}`}>{m.value}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Right: Real-time Operator Pipeline -->
      <div class="console-pane pane-queue">
        <div class="pane-tag">MONITORED OPERATOR WORKFLOW QUEUE</div>
        <div class="queue-list">
          <div class="queue-item item-active">
            <div class="item-head">
              <span class="item-tag tag-signal">SIGNAL INTAKE</span>
              <span class="item-time">0.12s ago</span>
            </div>
            <div class="item-title">Portfolio Exposure Divergence Detected</div>
            <div class="item-desc">Cross-referenced against verified risk boundary thresholds.</div>
          </div>

          <div class="queue-item item-review">
            <div class="item-head">
              <span class="item-tag tag-review">GOVERNED REVIEW</span>
              <span class="item-time">Pending</span>
            </div>
            <div class="item-title">Human-in-the-Loop Override Policy</div>
            <div class="item-desc">Awaiting principal risk engineer authorization check.</div>
          </div>

          <div class="queue-item">
            <div class="item-head">
              <span class="item-tag tag-trace">TRACE RECORD</span>
              <span class="item-time">Queued</span>
            </div>
            <div class="item-title">Cryptographic Decision Ledger Persistence</div>
            <div class="item-desc">Immutable audit event written to verified state store.</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .console-body {
    background: rgba(7, 17, 29, 0.95);
  }

  .console-subbar {
    background: rgba(255, 255, 255, 0.02);
    border-bottom: 1px solid var(--stroke);
    padding: 10px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .tab-list {
    display: flex;
    gap: 8px;
  }

  .console-tab {
    background: transparent;
    border: none;
    color: var(--muted);
    font-size: 13px;
    font-weight: 550;
    padding: 6px 14px;
    border-radius: var(--radius-full);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .console-tab.active {
    background: rgba(97, 173, 255, 0.14);
    color: var(--cyan);
    border: 1px solid rgba(121, 243, 255, 0.25);
  }

  .live-stream-status {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--green);
    font-family: var(--font-mono);
    font-size: 12px;
  }

  .status-pulse {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 10px var(--green);
  }

  .console-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 1px;
    background: var(--stroke);
  }

  @media (max-width: 900px) {
    .console-grid {
      grid-template-columns: 1fr;
    }
  }

  .console-pane {
    background: #08111e;
    padding: 24px;
  }

  .pane-tag {
    font-size: 11px;
    font-family: var(--font-mono);
    color: var(--muted2);
    letter-spacing: 0.12em;
    margin-bottom: 14px;
  }

  .code-box {
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid var(--stroke);
    border-radius: var(--radius-sm);
    padding: 16px;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.6;
    color: #e2e8f0;
    margin-bottom: 20px;
    overflow-x: auto;
  }

  .metrics-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .metric-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--stroke);
    border-radius: 12px;
    padding: 10px 16px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .metric-lbl {
    font-size: 10px;
    color: var(--muted2);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .metric-val {
    font-size: 15px;
    font-family: var(--font-mono);
    font-weight: 700;
  }

  .val-pass { color: var(--green); }
  .val-info { color: var(--blue); }
  .val-warn { color: var(--amber); }

  .queue-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .queue-item {
    background: rgba(255, 255, 255, 0.025);
    border: 1px solid var(--stroke);
    border-radius: 14px;
    padding: 14px 16px;
  }

  .queue-item.item-active {
    border-color: rgba(97, 173, 255, 0.3);
    background: rgba(97, 173, 255, 0.06);
  }

  .queue-item.item-review {
    border-color: rgba(157, 125, 255, 0.3);
    background: rgba(157, 125, 255, 0.06);
  }

  .item-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 6px;
  }

  .item-tag {
    font-size: 10px;
    font-family: var(--font-mono);
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 4px;
    letter-spacing: 0.05em;
  }

  .tag-signal {
    background: rgba(97, 173, 255, 0.15);
    color: var(--blue);
  }

  .tag-review {
    background: rgba(157, 125, 255, 0.15);
    color: var(--purple);
  }

  .tag-trace {
    background: rgba(78, 240, 193, 0.15);
    color: var(--green);
  }

  .item-time {
    font-size: 11px;
    color: var(--muted2);
    font-family: var(--font-mono);
  }

  .item-title {
    font-size: 14px;
    font-weight: 600;
    color: var(--text);
  }

  .item-desc {
    font-size: 12px;
    color: var(--muted);
    margin-top: 4px;
    line-height: 1.4;
  }
</style>
