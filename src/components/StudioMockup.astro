---
interface Props {
  studioName: string;
  stageBadge?: string;
  activeTab?: string;
  executionMetrics?: { label: string; value: string; status?: 'pass' | 'warn' | 'info' }[];
  codeSnippet?: string;
}

const {
  studioName = "AI Studio",
  stageBadge = "ENTERPRISE CONSOLE",
  activeTab = "Requirement Graph",
  executionMetrics = [
    { label: "Deterministic Quality Score", value: "99.8%", status: "pass" },
    { label: "P99 Execution Latency", value: "32ms", status: "info" },
    { label: "Zero-Trust Policy Adherence", value: "100.0%", status: "pass" }
  ],
  codeSnippet = `// VERIQON ONE Quality Engine Verification Topology
const testGraph = await veriqon.synthesizeQualityPipeline({
  source: "REQUIREMENTS_JIRA_CONFLUENCE",
  engine: "VERIQON_ONE_DETERMINISTIC_RUNTIME",
  governance: "ZERO_TRUST_RBAC_POLICY",
  validation: ["CONTRACT_API", "ETL_RECONCILIATION", "DAST_SECURITY"]
});`
} = Astro.props;
---

<div class="mockup-window" role="region" aria-label={`${studioName} Console Preview`}>
  <div class="mockup-header">
    <div class="window-controls" aria-hidden="true">
      <span class="window-dot dot-red"></span>
      <span class="window-dot dot-yellow"></span>
      <span class="window-dot dot-green"></span>
    </div>
    <div class="mockup-title">
      <span class="product-name">VERIQON ONE</span> &bull; <span>{studioName}</span>
      <span class="powered-badge">by VERIQON TECHNOLOGIES</span>
    </div>
    <div class="mockup-badge">
      {stageBadge}
    </div>
  </div>

  <div class="console-body">
    <!-- Console Subbar -->
    <div class="console-subbar">
      <div class="tab-list">
        <button type="button" class={`console-tab ${activeTab === 'Requirement Graph' ? 'active' : ''}`}>{activeTab}</button>
        <button type="button" class="console-tab">Execution Pipeline</button>
        <button type="button" class="console-tab">Traceability Matrix</button>
        <button type="button" class="console-tab">Cryptographic Audit</button>
      </div>
      <div class="live-stream-status">
        <span class="status-pulse"></span> Telemetry Active
      </div>
    </div>

    <!-- Main Console Grid -->
    <div class="console-grid">
      <!-- Left: Engine Execution & Code -->
      <div class="console-pane">
        <div class="pane-tag">SPECIFICATION &amp; REASONING TOPOLOGY</div>
        <pre class="code-box"><code><span class="code-comment">{codeSnippet}</span></code></pre>

        <!-- KPI Metrics Row -->
        <div class="metrics-row">
          {executionMetrics.map((m) => (
            <div class="metric-card">
              <span class="metric-lbl">{m.label}</span>
              <span class={`metric-val val-${m.status || 'info'}`}>{m.value}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Right: Real-time Operator Pipeline -->
      <div class="console-pane pane-queue">
        <div class="pane-tag">VERIFIED EXECUTION &amp; AUDIT PIPELINE</div>
        <div class="queue-list">
          <div class="queue-item item-active">
            <div class="item-head">
              <span class="item-tag tag-signal">DISCOVERY</span>
              <span class="item-time">0.08s</span>
            </div>
            <div class="item-title">Enterprise Requirement Topology Parsed</div>
            <div class="item-desc">User journeys mapped to verifiable acceptance criteria.</div>
          </div>

          <div class="queue-item item-review">
            <div class="item-head">
              <span class="item-tag tag-review">GOVERNANCE</span>
              <span class="item-time">Enforced</span>
            </div>
            <div class="item-title">Zero-Trust Role-Based Authorization</div>
            <div class="item-desc">Execution parameters verified against compliance policies.</div>
          </div>

          <div class="queue-item">
            <div class="item-head">
              <span class="item-tag tag-trace">VERIFICATION</span>
              <span class="item-time">Complete</span>
            </div>
            <div class="item-title">Deterministic Defect Trace Ledger</div>
            <div class="item-desc">Cryptographic test run lineage persisted to audit store.</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .mockup-window {
    background: #061B36;
    border: 1px solid rgba(8, 197, 232, 0.28);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(6, 27, 54, 0.45);
    margin-top: 2.5rem;
    margin-bottom: 2.5rem;
    text-align: left;
  }

  .mockup-header {
    background: #0A2547;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    padding: 14px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .window-controls {
    display: flex;
    gap: 7px;
  }

  .window-dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
  }

  .dot-red { background: #ff5f56; }
  .dot-yellow { background: #ffbd2e; }
  .dot-green { background: #27c93f; }

  .mockup-title {
    font-size: 13px;
    font-family: var(--font-mono);
    color: #E2E8F0;
    letter-spacing: -0.01em;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .product-name {
    font-weight: 750;
    color: var(--cyan);
  }

  .powered-badge {
    font-size: 10px;
    color: #94A3B8;
    background: rgba(255, 255, 255, 0.06);
    padding: 2px 8px;
    border-radius: 4px;
  }

  .mockup-badge {
    font-size: 11px;
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--cyan);
    background: rgba(8, 197, 232, 0.12);
    padding: 4px 10px;
    border-radius: 6px;
    border: 1px solid rgba(8, 197, 232, 0.25);
  }

  .console-body {
    background: #061B36;
  }

  .console-subbar {
    background: rgba(10, 37, 71, 0.6);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding: 10px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .tab-list {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    max-width: 100%;
    padding-bottom: 2px;
  }

  .tab-list::-webkit-scrollbar {
    display: none;
  }

  .console-tab {
    background: transparent;
    border: none;
    color: #C7D0DA;
    font-size: 13px;
    font-weight: 600;
    padding: 6px 14px;
    border-radius: var(--radius-full);
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .console-tab.active {
    background: rgba(8, 119, 232, 0.25);
    color: #FFFFFF;
    border: 1px solid rgba(8, 197, 232, 0.4);
  }

  .live-stream-status {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--cyan);
    font-family: var(--font-mono);
    font-size: 12px;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .status-pulse {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--cyan);
    box-shadow: 0 0 10px var(--cyan);
  }

  .console-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 1px;
    background: rgba(255, 255, 255, 0.08);
  }

  @media (max-width: 900px) {
    .console-grid {
      grid-template-columns: 1fr;
    }

    .console-subbar {
      padding: 10px 16px;
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }

    .tab-list {
      width: 100%;
    }

    .console-pane {
      padding: 18px 16px;
    }
  }

  @media (max-width: 640px) {
    .mockup-header {
      padding: 10px 14px;
      gap: 8px;
    }

    .mockup-title {
      font-size: 11px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .powered-badge {
      display: none;
    }

    .mockup-badge {
      display: none;
    }

    .metrics-row {
      display: grid;
      grid-template-columns: 1fr;
      width: 100%;
    }

    .metric-card {
      width: 100%;
    }
  }

  .console-pane {
    background: #061B36;
    padding: 24px;
  }

  .pane-tag {
    font-size: 11px;
    font-family: var(--font-mono);
    color: var(--cyan);
    letter-spacing: 0.12em;
    margin-bottom: 14px;
    font-weight: 700;
  }

  .code-box {
    background: #0A2547;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-sm);
    padding: 16px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 1.6;
    color: #E2E8F0;
    margin-bottom: 20px;
    overflow-x: auto;
  }

  .code-comment {
    color: #94A3B8;
  }

  .metrics-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .metric-card {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 10px;
    padding: 10px 16px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .metric-lbl {
    font-size: 10px;
    color: #C7D0DA;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .metric-val {
    font-size: 15px;
    font-family: var(--font-mono);
    font-weight: 700;
  }

  .val-pass { color: var(--cyan); }
  .val-info { color: #0877E8; }
  .val-warn { color: #f59e0b; }

  .queue-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .queue-item {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    padding: 14px 16px;
  }

  .queue-item.item-active {
    border-color: rgba(8, 197, 232, 0.4);
    background: rgba(8, 197, 232, 0.06);
  }

  .queue-item.item-review {
    border-color: rgba(8, 119, 232, 0.4);
    background: rgba(8, 119, 232, 0.06);
  }

  .item-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 6px;
  }

  .item-tag {
    font-size: 10px;
    font-family: var(--font-mono);
    font-weight: 750;
    padding: 2px 8px;
    border-radius: 4px;
    letter-spacing: 0.05em;
  }

  .tag-signal {
    background: rgba(8, 197, 232, 0.15);
    color: var(--cyan);
  }

  .tag-review {
    background: rgba(8, 119, 232, 0.2);
    color: #61adff;
  }

  .tag-trace {
    background: rgba(255, 255, 255, 0.1);
    color: #FFFFFF;
  }

  .item-time {
    font-size: 11px;
    color: #94A3B8;
    font-family: var(--font-mono);
  }

  .item-title {
    font-size: 13.5px;
    font-weight: 650;
    color: #FFFFFF;
  }

  .item-desc {
    font-size: 12px;
    color: #C7D0DA;
    margin-top: 4px;
    line-height: 1.4;
  }
</style>
