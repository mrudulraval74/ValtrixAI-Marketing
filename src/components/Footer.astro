---
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <!-- Col 1: Brand Info -->
      <div class="footer-col brand-col">
        <a href="/" class="brand" style="margin-bottom: 1.25rem;">
          <div class="brand-mark" style="width: 38px; height: 38px;">
            <svg viewBox="0 0 32 32" fill="none" class="brand-svg">
              <path d="M16 3L27 8V17C27 24 21 28.5 16 30C11 28.5 5 24 5 17V8L16 3Z" fill="url(#ft-grad)" fill-opacity="0.3" stroke="url(#ft-stroke)" stroke-width="1.5" />
              <path d="M10 11L16 23L22 11H18.5L16 16.5L13.5 11H10Z" fill="#ffffff" />
              <defs>
                <linearGradient id="ft-grad" x1="0" y1="0" x2="32" y2="32">
                  <stop stop-color="#61adff" />
                  <stop offset="0.5" stop-color="#9d7dff" />
                  <stop offset="1" stop-color="#ff6fd7" />
                </linearGradient>
                <linearGradient id="ft-stroke" x1="0" y1="0" x2="32" y2="32">
                  <stop stop-color="#79f3ff" />
                  <stop offset="1" stop-color="#9d7dff" />
                </linearGradient>
              </defs>
            </svg>
          </div>
          <div class="brand-text">
            <span class="brand-title" style="font-size: 18px;">Valtrix AI</span>
            <span class="brand-sub">Strategic Intelligence Systems</span>
          </div>
        </a>
        <p class="footer-copy">
          Valtrix AI builds intelligence systems for financial monitoring, industrial inspection, and operational decision workflows where teams need clear signals, governed review, and fast routing.
        </p>
        <div class="institutional-badge">
          <span class="status-dot"></span>
          <span>Global Institutional Engagement</span>
        </div>
      </div>

      <!-- Col 2: Testing Studios -->
      <div class="footer-col">
        <h4 class="footer-head">Intelligence Studios</h4>
        <ul class="footer-nav">
          <li><a href="/studios/ai-end-to-end">AI End-to-End Studio</a></li>
          <li><a href="/studios/automation">Automation Studio</a></li>
          <li><a href="/studios/etl-testing">ETL Testing Studio</a></li>
          <li><a href="/studios/performance-testing">Performance Studio</a></li>
          <li><a href="/studios/security-testing">Security Studio</a></li>
          <li><a href="/studios/manual-testing">Manual Testing Studio</a></li>
        </ul>
      </div>

      <!-- Col 3: Platform & Solutions -->
      <div class="footer-col">
        <h4 class="footer-head">Platform</h4>
        <ul class="footer-nav">
          <li><a href="/platform">Platform Architecture</a></li>
          <li><a href="/features">Feature Matrix</a></li>
          <li><a href="/solutions">Industry Solutions</a></li>
          <li><a href="/pricing">Pricing &amp; Engagements</a></li>
          <li><a href="/resources">Technical Resources</a></li>
        </ul>
      </div>

      <!-- Col 4: Corporate & Office -->
      <div class="footer-col">
        <h4 class="footer-head">Headquarters &amp; Contact</h4>
        <p class="office-text">
          <strong>Offices:</strong><br />
          New York &bull; San Francisco<br />
          Global institutional briefings
        </p>
        <p class="office-text" style="margin-top: 12px;">
          <strong>Direct Inquiries:</strong><br />
          <a href="mailto:contact@valtrix.ai" class="email-link">contact@valtrix.ai</a><br />
          <a href="mailto:partners@valtrix.ai" class="email-link">partners@valtrix.ai</a>
        </p>
        <ul class="footer-nav" style="margin-top: 14px;">
          <li><a href="/about">About Us</a></li>
          <li><a href="/privacy">Privacy Policy</a></li>
          <li><a href="/terms">Terms of Service</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <div>
        &copy; {currentYear} Valtrix AI. All rights reserved.
      </div>
      <div class="footer-tagline">
        Monitored Workflows &bull; Governed Review &bull; Traceable Outcomes
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: #050b14;
    border-top: 1px solid var(--stroke);
    padding: clamp(60px, 7vw, 90px) 0 36px;
    color: var(--muted);
    font-size: 14px;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1.3fr;
    gap: clamp(24px, 4vw, 48px);
    margin-bottom: 50px;
  }

  @media (max-width: 1024px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }

  .footer-copy {
    line-height: 1.8;
    color: var(--muted2);
    max-width: 380px;
    margin-bottom: 18px;
    font-size: 14px;
  }

  .institutional-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--stroke);
    font-size: 12px;
    color: var(--cyan);
    font-weight: 500;
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 8px var(--green);
  }

  .footer-head {
    color: var(--text);
    font-size: 15px;
    font-weight: 650;
    letter-spacing: -0.01em;
    margin-bottom: 20px;
  }

  .footer-nav {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footer-nav a {
    color: var(--muted);
    transition: color 0.2s ease;
  }

  .footer-nav a:hover {
    color: var(--cyan);
  }

  .office-text {
    line-height: 1.7;
    color: var(--muted2);
    font-size: 13px;
  }

  .email-link {
    color: var(--cyan);
  }

  .email-link:hover {
    text-decoration: underline;
  }

  .footer-bottom {
    padding-top: 28px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 13px;
    color: var(--muted2);
  }

  @media (max-width: 640px) {
    .footer-bottom {
      flex-direction: column;
      gap: 12px;
      text-align: center;
    }
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .brand-mark {
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: radial-gradient(circle at 28% 24%, rgba(97, 173, 255, 0.28), rgba(157, 125, 255, 0.22) 55%, rgba(255, 111, 215, 0.16) 100%), #0d1629;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6px;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .brand-title {
    font-size: 18px;
    font-weight: 700;
    color: var(--text);
  }

  .brand-sub {
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--cyan);
    font-weight: 600;
  }
</style>
