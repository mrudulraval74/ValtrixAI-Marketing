---
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer-top-grid">
      <!-- Col 1: Corporate & Brand Architecture -->
      <div class="footer-col brand-col">
        <a href="/" class="footer-brand" aria-label="VERIQON TECHNOLOGIES Home">
          <div class="footer-brand-mark">
            <svg viewBox="0 0 48 48" fill="none" class="brand-svg">
              <defs>
                <linearGradient id="ft-v" x1="6" y1="8" x2="26" y2="38" gradientUnits="userSpaceOnUse">
                  <stop stop-color="#08C5E8" />
                  <stop offset="0.6" stop-color="#0877E8" />
                  <stop offset="1" stop-color="#0652A8" />
                </linearGradient>
                <linearGradient id="ft-silver" x1="18" y1="8" x2="42" y2="34" gradientUnits="userSpaceOnUse">
                  <stop stop-color="#FFFFFF" />
                  <stop offset="0.4" stop-color="#E2E8F0" />
                  <stop offset="0.8" stop-color="#94A3B8" />
                  <stop offset="1" stop-color="#64748B" />
                </linearGradient>
                <linearGradient id="ft-cyan" x1="26" y1="26" x2="44" y2="40" gradientUnits="userSpaceOnUse">
                  <stop stop-color="#08C5E8" />
                  <stop offset="1" stop-color="#0877E8" />
                </linearGradient>
              </defs>
              <path d="M6 10L16 38L24 22L17 10H6Z" fill="url(#ft-v)" />
              <path d="M16 38L21 16L24 22L16 38Z" fill="#08C5E8" fill-opacity="0.9" />
              <path d="M21 10H37L42 19L36 30H26L30 22H34L37 18L33 14H24L21 10Z" fill="url(#ft-silver)" />
              <path d="M27 25L39 38H45L33 25H27Z" fill="url(#ft-cyan)" />
            </svg>
          </div>
          <div class="footer-brand-text">
            <span class="footer-brand-title">VERIQON</span>
            <span class="footer-brand-sub">TECHNOLOGIES</span>
          </div>
        </a>

        <p class="footer-tagline-quote">
          &ldquo;Engineering Trust Through Intelligence.&rdquo;
        </p>

        <p class="footer-copy">
          VERIQON TECHNOLOGIES delivers intelligent quality engineering and enterprise software platforms designed to guarantee release confidence, determinism, and full-stack verification.
        </p>

        <div class="product-badge-card">
          <div class="badge-label">FLAGSHIP PLATFORM</div>
          <div class="badge-prod-name">
            <strong>VERIQON ONE</strong>
            <span>Enterprise Quality Engineering Platform</span>
          </div>
          <div class="badge-subtext">Powered by VERIQON TECHNOLOGIES</div>
        </div>
      </div>

      <!-- Col 2: VERIQON ONE Studios -->
      <div class="footer-col">
        <h4 class="footer-head">Specialist Studios</h4>
        <ul class="footer-nav">
          <li><a href="/studios/ai-studio">AI Studio</a></li>
          <li><a href="/studios/automation">Automation Studio</a></li>
          <li><a href="/studios/api-testing">API Testing Studio</a></li>
          <li><a href="/studios/etl-testing">ETL / Data Testing Studio</a></li>
          <li><a href="/studios/performance-testing">Performance Studio</a></li>
          <li><a href="/studios/security-testing">Security Studio</a></li>
          <li><a href="/studios/manual-testing">Manual Testing Studio</a></li>
          <li><a href="/ai-studios" class="link-highlight">All Studios Overview &rarr;</a></li>
        </ul>
      </div>

      <!-- Col 3: Platform & Solutions -->
      <div class="footer-col">
        <h4 class="footer-head">Platform &amp; Solutions</h4>
        <ul class="footer-nav">
          <li><a href="/platform">Platform Architecture</a></li>
          <li><a href="/solutions">Quality Engineering Solutions</a></li>
          <li><a href="/industries">Industry Verticals</a></li>
          <li><a href="/enterprise">Enterprise Architecture</a></li>
          <li><a href="/pricing">Pricing &amp; Deployment</a></li>
          <li><a href="/request-demo" class="link-highlight">Request Enterprise Demo</a></li>
        </ul>
      </div>

      <!-- Col 4: Corporate & Resources -->
      <div class="footer-col">
        <h4 class="footer-head">Company &amp; Resources</h4>
        <ul class="footer-nav">
          <li><a href="/about">About VERIQON TECHNOLOGIES</a></li>
          <li><a href="/resources">Documentation &amp; Guides</a></li>
          <li><a href="/contact">Contact Sales &amp; Support</a></li>
          <li><a href="/security">Security &amp; Trust</a></li>
          <li><a href="/privacy">Privacy Policy</a></li>
          <li><a href="/terms">Terms of Service</a></li>
          <li><a href="/cookies">Cookie Policy</a></li>
        </ul>

        <div class="direct-contact-box">
          <span class="contact-lbl">Direct Enterprise Inquiries:</span>
          <a href="mailto:sales@veriqon.com" class="contact-link">sales@veriqon.com</a>
          <a href="mailto:enterprise@veriqon.com" class="contact-link">enterprise@veriqon.com</a>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="footer-bottom">
      <div class="copyright-text">
        &copy; {currentYear} VERIQON TECHNOLOGIES. All rights reserved. VERIQON ONE is an Enterprise Quality Engineering Platform developed and owned by VERIQON TECHNOLOGIES.
      </div>
      <div class="footer-trust-marks">
        <span>Deterministic Verification</span> &bull; <span>Zero-Trust Architecture</span> &bull; <span>Enterprise RBAC</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: #061B36;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    padding: clamp(64px, 7vw, 96px) 0 36px;
    color: #C7D0DA;
    font-size: 14px;
  }

  .footer-top-grid {
    display: grid;
    grid-template-columns: 1.8fr 1.2fr 1.2fr 1.4fr;
    gap: clamp(24px, 4vw, 56px);
    margin-bottom: 56px;
  }

  @media (max-width: 1060px) {
    .footer-top-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .footer-top-grid {
      grid-template-columns: 1fr;
    }
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 14px;
  }

  .footer-brand-mark {
    width: 38px;
    height: 38px;
    border-radius: 9px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(8, 197, 232, 0.35);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6px;
  }

  .footer-brand-title {
    font-size: 19px;
    font-weight: 800;
    letter-spacing: 0.05em;
    color: #FFFFFF;
  }

  .footer-brand-sub {
    font-size: 9.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--cyan);
    font-weight: 700;
    display: block;
  }

  .footer-tagline-quote {
    color: var(--cyan);
    font-weight: 600;
    font-size: 14.5px;
    margin-bottom: 12px;
  }

  .footer-copy {
    color: #94A3B8;
    line-height: 1.7;
    font-size: 13.5px;
    max-width: 380px;
    margin-bottom: 20px;
  }

  .product-badge-card {
    background: rgba(10, 37, 71, 0.7);
    border: 1px solid rgba(8, 197, 232, 0.25);
    border-radius: var(--radius-sm);
    padding: 12px 16px;
    max-width: 380px;
  }

  .badge-label {
    font-size: 9.5px;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--cyan);
    font-weight: 750;
    margin-bottom: 4px;
  }

  .badge-prod-name {
    display: flex;
    flex-direction: column;
    color: #FFFFFF;
  }

  .badge-prod-name strong {
    font-size: 15px;
    letter-spacing: 0.02em;
  }

  .badge-prod-name span {
    font-size: 11.5px;
    color: #C7D0DA;
  }

  .badge-subtext {
    font-size: 11px;
    color: var(--silver);
    margin-top: 6px;
    font-style: italic;
  }

  .footer-head {
    color: #FFFFFF;
    font-size: 14.5px;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    margin-bottom: 18px;
  }

  .footer-nav {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-nav a {
    color: #C7D0DA;
    font-size: 13.5px;
    transition: color 0.18s ease;
  }

  .footer-nav a:hover {
    color: var(--cyan);
  }

  .link-highlight {
    color: var(--cyan) !important;
    font-weight: 600;
  }

  .direct-contact-box {
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .contact-lbl {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #94A3B8;
  }

  .contact-link {
    color: var(--cyan);
    font-size: 13px;
    font-family: var(--font-mono);
  }

  .contact-link:hover {
    text-decoration: underline;
  }

  .footer-bottom {
    padding-top: 28px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    font-size: 12.5px;
    color: #94A3B8;
  }

  @media (max-width: 820px) {
    .footer-bottom {
      flex-direction: column;
      text-align: center;
    }
  }

  .copyright-text {
    max-width: 680px;
    line-height: 1.5;
  }

  .footer-trust-marks {
    font-family: var(--font-mono);
    font-size: 11px;
    color: #C7D0DA;
    white-space: nowrap;
  }
</style>
