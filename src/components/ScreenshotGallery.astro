---
// Pixel-Perfect Native Retina Product Showcase for VERIQON ONE
// Faithfully reconstructed from the real application architecture with authentic branding and populated enterprise telemetry.
---

<div class="product-app-showcase" role="region" aria-label="VERIQON ONE Platform Live Interface">
  <!-- Section Header -->
  <div class="showcase-header text-center">
    <div class="eyebrow">
      <span class="badge-dot"></span> High-Fidelity Platform Architecture
    </div>
    <h2 class="heading-lg">The VERIQON ONE Operating System</h2>
    <p class="subheading">
      Explore the comprehensive interface of VERIQON ONE &mdash; purpose-built to connect product engineering, autonomous test synthesis, distributed execution, and enterprise governance into one deterministic console.
    </p>

    <!-- View Selector Tabs -->
    <div class="app-view-nav" role="tablist">
      <button type="button" class="view-btn active" data-view="dashboard" role="tab" aria-selected="true">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="3" width="7" height="7"></rect>
          <rect x="14" y="3" width="7" height="7"></rect>
          <rect x="14" y="14" width="7" height="7"></rect>
          <rect x="3" y="14" width="7" height="7"></rect>
        </svg>
        <span>Dashboard &amp; Lifecycle</span>
      </button>

      <button type="button" class="view-btn" data-view="execution" role="tab" aria-selected="false">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polygon points="5 3 19 12 5 21 5 3"></polygon>
        </svg>
        <span>Execution Center</span>
        <span class="btn-pill">12 Nodes</span>
      </button>

      <button type="button" class="view-btn" data-view="traceability" role="tab" aria-selected="false">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="20" x2="18" y2="10"></line>
          <line x1="12" y1="20" x2="12" y2="4"></line>
          <line x1="6" y1="20" x2="6" y2="14"></line>
        </svg>
        <span>Coverage &amp; Traceability</span>
        <span class="btn-pill" style="color: #10b981;">100%</span>
      </button>

      <button type="button" class="view-btn" data-view="defects" role="tab" aria-selected="false">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="4" y="4" width="16" height="16" rx="2"></rect>
          <path d="M9 9h6v6H9z"></path>
        </svg>
        <span>Defect Decision Center</span>
      </button>

      <button type="button" class="view-btn" data-view="roles" role="tab" aria-selected="false">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
        </svg>
        <span>Roles &amp; Permissions</span>
        <span class="btn-pill">22 Roles</span>
      </button>
    </div>
  </div>

  <!-- The Native Application Window Frame -->
  <div class="browser-window-frame">
    <!-- Browser Top Bar -->
    <div class="window-chrome">
      <div class="chrome-dots">
        <span class="c-dot dot-r"></span>
        <span class="c-dot dot-y"></span>
        <span class="c-dot dot-g"></span>
      </div>
      <div class="chrome-url-bar">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#64748B" stroke-width="2">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
        <span class="url-text">https://app.veriqon.com/workspace/primary-project</span>
        <span class="url-badge">TLS 1.3 &bull; SOC 2</span>
      </div>
      <div class="chrome-status">
        <span class="status-dot"></span>
        <span>VERIQON ONE v4.8 Enterprise</span>
      </div>
    </div>

    <!-- Application Body Layout -->
    <div class="app-layout">
      <!-- Left Sidebar (Faithful to Real Software) -->
      <aside class="app-sidebar">
        <!-- Sidebar Brand -->
        <div class="sb-brand">
          <svg class="sb-logo" width="22" height="22" viewBox="0 0 100 100" fill="none">
            <path d="M12 20 L35 76 L52 40 L35 20 Z" fill="#0877E8"/>
            <path d="M42 20 L60 56 L68 40 L58 20 Z" fill="#08C5E8"/>
            <path d="M52 20 L78 20 L88 38 L76 56 L64 56 L72 40 Z" fill="#C7D0DA"/>
            <path d="M60 56 L78 80 L62 80 L48 62 Z" fill="#08C5E8"/>
          </svg>
          <span class="sb-title">VERIQON <strong style="color: #0877E8;">ONE</strong></span>
        </div>

        <!-- Project / Workspace Selector Card -->
        <div class="sb-workspace-card">
          <div class="sb-ws-label">Default Workspace</div>
          <div class="sb-ws-name">Primary Project</div>
        </div>

        <!-- Navigation Links -->
        <nav class="sb-nav">
          <a class="sb-link active">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
            <span>Dashboard</span>
          </a>
          <a class="sb-link">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
            <span>Projects</span>
          </a>
          <a class="sb-link">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            <span>My Work</span>
          </a>

          <div class="sb-group-label">PRODUCT ENGINEERING</div>
          <a class="sb-link"><span>Requirements</span></a>
          <a class="sb-link"><span>User Stories</span></a>
          <a class="sb-link"><span>Tasks</span></a>
          <a class="sb-link"><span>Defects</span></a>

          <div class="sb-group-label">TEST MANAGEMENT</div>
          <a class="sb-link"><span>Test Scenarios</span></a>
          <a class="sb-link"><span>Test Repository</span></a>
          <a class="sb-link"><span>Test Runs</span></a>
          <a class="sb-link"><span>% Coverage &amp; Traceability</span></a>

          <div class="sb-group-label">AI TESTING STUDIOS</div>
          <a class="sb-link"><span class="sb-st-dot"></span><span>AI Studio</span></a>
          <a class="sb-link"><span class="sb-st-dot"></span><span>Automation Studio</span></a>
          <a class="sb-link"><span class="sb-st-dot"></span><span>API Testing Studio</span></a>
          <a class="sb-link"><span class="sb-st-dot"></span><span>ETL / Data Testing</span></a>
          <a class="sb-link"><span class="sb-st-dot"></span><span>Performance Studio</span></a>
          <a class="sb-link"><span class="sb-st-dot"></span><span>Security Studio</span></a>
        </nav>

        <!-- Sidebar Footer -->
        <div class="sb-footer">
          <div class="sb-health">
            <span class="health-dot"></span>
            <span>SYSTEM HEALTH: 12 nodes online</span>
          </div>
          <div class="sb-user">
            <div class="user-avatar">QA</div>
            <div class="user-info">
              <span class="user-email">qa.lead@veriqon.com</span>
              <span class="user-role">Enterprise Administrator</span>
            </div>
          </div>
        </div>
      </aside>

      <!-- Main Application Content Area -->
      <main class="app-main">
        <!-- Top App Navigation Bar -->
        <header class="app-topbar">
          <div class="topbar-breadcrumbs">
            <span>VERIQON ONE</span>
            <span class="bc-sep">/</span>
            <span>Default Workspace</span>
            <span class="bc-sep">/</span>
            <span class="bc-active">Primary Project</span>
          </div>

          <div class="topbar-search-box">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#94A3B8" stroke-width="2">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input type="text" placeholder="Search projects, test cases... (Ctrl+K)" readonly />
          </div>

          <div class="topbar-actions">
            <div class="ai-online-badge">
              <span class="ai-dot"></span>
              <span>AI Online</span>
            </div>
            <button type="button" class="topbar-icon-btn">+</button>
            <button type="button" class="topbar-icon-btn">EN</button>
            <div class="topbar-avatar">A</div>
          </div>
        </header>

        <!-- Dynamic Screen Content Panels -->
        <div class="screen-body-container">
          
          <!-- VIEW 1: DASHBOARD & QUALITY LIFECYCLE -->
          <div class="view-panel active" id="view-dashboard">
            <div class="dash-welcome-card">
              <div class="welcome-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0877E8" stroke-width="2">
                  <rect x="3" y="3" width="7" height="7"></rect>
                  <rect x="14" y="3" width="7" height="7"></rect>
                  <rect x="14" y="14" width="7" height="7"></rect>
                  <rect x="3" y="14" width="7" height="7"></rect>
                </svg>
              </div>
              <div class="welcome-text">
                <h3 class="welcome-heading">Good evening, Admin</h3>
                <p class="welcome-sub">Here's what's happening across your workspace and 7 specialist quality studios today.</p>
              </div>
            </div>

            <div class="project-toolbar-row">
              <div class="active-proj-pill">
                <strong>Primary Project</strong> &bull; Saturday, November 14, 2026
              </div>
              <button class="app-btn-blue">+ New Project</button>
            </div>

            <!-- Autonomous Quality Engineering Lifecycle (The 5-Step Engine) -->
            <div class="lifecycle-container-card">
              <div class="lifecycle-header-bar">
                <div class="lf-title-group">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0877E8" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                  </svg>
                  <span class="lf-title">Autonomous Quality Engineering Lifecycle</span>
                  <span class="lf-badge">END-TO-END FLOW</span>
                </div>
                <span class="lf-sublink">Launch Flagship AI Studio &rarr;</span>
              </div>

              <!-- 5 Stage Cards from the real application -->
              <div class="lifecycle-five-grid">
                <!-- Step 01 -->
                <div class="lifecycle-box">
                  <div class="lb-header">
                    <span class="lb-step">STEP 01</span>
                    <span class="lb-status-green">Setup Active</span>
                  </div>
                  <div class="lb-icon-title">
                    <div class="icon-circle" style="color: #0877E8; background: #EFF6FF;">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path></svg>
                    </div>
                    <strong>Specify &amp; Ingest</strong>
                  </div>
                  <p class="lb-desc">Requirements &amp; User Stories</p>
                  <div class="lb-foot">
                    <span class="lb-count">48 Tracked</span>
                    <span class="lb-arrow">&rarr;</span>
                  </div>
                </div>

                <!-- Step 02 (AI Flagship) -->
                <div class="lifecycle-box box-highlight">
                  <div class="lb-header">
                    <span class="lb-step" style="color: #08C5E8;">STEP 02</span>
                    <span class="lb-status-blue">AI Flagship</span>
                  </div>
                  <div class="lb-icon-title">
                    <div class="icon-circle" style="color: #08C5E8; background: rgba(8, 197, 232, 0.15);">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                    </div>
                    <strong style="color: #061B36;">AI Synthesis</strong>
                  </div>
                  <p class="lb-desc">Autonomous Test Modeling</p>
                  <div class="lb-foot">
                    <span class="lb-count" style="color: #0877E8;">1,420 Generated</span>
                    <span class="lb-arrow">&rarr;</span>
                  </div>
                </div>

                <!-- Step 03 -->
                <div class="lifecycle-box">
                  <div class="lb-header">
                    <span class="lb-step">STEP 03</span>
                    <span class="lb-status-green">Plan Ready</span>
                  </div>
                  <div class="lb-icon-title">
                    <div class="icon-circle" style="color: #10B981; background: #ECFDF5;">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 11 12 14 22 4"></polyline><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path></svg>
                    </div>
                    <strong>Plan &amp; Structure</strong>
                  </div>
                  <p class="lb-desc">Suites &amp; Traceability</p>
                  <div class="lb-foot">
                    <span class="lb-count">56 Test Suites</span>
                    <span class="lb-arrow">&rarr;</span>
                  </div>
                </div>

                <!-- Step 04 -->
                <div class="lifecycle-box">
                  <div class="lb-header">
                    <span class="lb-step">STEP 04</span>
                    <span class="lb-status-amber">Queue Live</span>
                  </div>
                  <div class="lb-icon-title">
                    <div class="icon-circle" style="color: #F59E0B; background: #FFFBEB;">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polygon points="10 8 16 12 10 16 10 8"></polygon></svg>
                    </div>
                    <strong>Execute &amp; Monitor</strong>
                  </div>
                  <p class="lb-desc">Execution Center &amp; Workers</p>
                  <div class="lb-foot">
                    <span class="lb-count" style="color: #10B981;">12 Active Nodes</span>
                    <span class="lb-arrow">&rarr;</span>
                  </div>
                </div>

                <!-- Step 05 -->
                <div class="lifecycle-box">
                  <div class="lb-header">
                    <span class="lb-step">STEP 05</span>
                    <span class="lb-status-green">Protected</span>
                  </div>
                  <div class="lb-icon-title">
                    <div class="icon-circle" style="color: #EF4444; background: #FEF2F2;">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                    </div>
                    <strong>Triage &amp; Protect</strong>
                  </div>
                  <p class="lb-desc">AI Root Cause &amp; Defense</p>
                  <div class="lb-foot">
                    <span class="lb-count" style="color: #10B981;">99.8% Pass Rate</span>
                    <span class="lb-arrow">&rarr;</span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- VIEW 2: UNIFIED EXECUTION CENTER -->
          <div class="view-panel" id="view-execution">
            <div class="exec-kpis-grid">
              <div class="exec-kpi-card">
                <span class="kpi-label">TOTAL EXECUTIONS</span>
                <span class="kpi-num">14,820</span>
                <span class="kpi-sub" style="color: #10B981;">+1,420 runs today</span>
              </div>
              <div class="exec-kpi-card">
                <span class="kpi-label">QUEUE DEPTH</span>
                <span class="kpi-num" style="color: #08C5E8;">0</span>
                <span class="kpi-sub">Real-time throughput</span>
              </div>
              <div class="exec-kpi-card">
                <span class="kpi-label">ACTIVE RUNNER NODES</span>
                <span class="kpi-num" style="color: #0877E8;">12 Online</span>
                <span class="kpi-sub">Air-gapped Kubernetes</span>
              </div>
              <div class="exec-kpi-card">
                <span class="kpi-label">PASS RATE</span>
                <span class="kpi-num" style="color: #10B981;">99.81%</span>
                <span class="kpi-sub">Zero flaky failures</span>
              </div>
              <div class="exec-kpi-card">
                <span class="kpi-label">FAILED REQUIRING ATTENTION</span>
                <span class="kpi-num" style="color: #64748B;">0</span>
                <span class="kpi-sub" style="color: #10B981;">All auto-healed</span>
              </div>
            </div>

            <!-- Recent Unified Executions Table -->
            <div class="exec-table-card">
              <div class="table-header-row">
                <span class="th-title">Recent Unified Executions Across Specialist Studios</span>
                <span class="th-badge">Live Stream Connected</span>
              </div>
              <table class="app-table">
                <thead>
                  <tr>
                    <th>Execution ID</th>
                    <th>Studio Dispatcher</th>
                    <th>Target Scope</th>
                    <th>Duration</th>
                    <th>Runner Topology</th>
                    <th>Execution Result</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td><code>EXEC-8492</code></td>
                    <td><strong>Automation Studio</strong></td>
                    <td>Multi-Step Checkout E2E</td>
                    <td>0.42s</td>
                    <td>Chromium &bull; WebKit &bull; Firefox</td>
                    <td><span class="tag-pass">PASSED</span></td>
                  </tr>
                  <tr>
                    <td><code>EXEC-8491</code></td>
                    <td><strong>API Testing Studio</strong></td>
                    <td>OpenAPI Contract Regression</td>
                    <td>0.08s</td>
                    <td>REST / GraphQL Service Mesh</td>
                    <td><span class="tag-pass">PASSED</span></td>
                  </tr>
                  <tr>
                    <td><code>EXEC-8490</code></td>
                    <td><strong>ETL / Data Testing</strong></td>
                    <td>Snowflake 1.2M Row Ledger Recon</td>
                    <td>1.14s</td>
                    <td>SIMD Vector Hash Engine</td>
                    <td><span class="tag-pass">PASSED</span></td>
                  </tr>
                  <tr>
                    <td><code>EXEC-8489</code></td>
                    <td><strong>Security Studio</strong></td>
                    <td>PostgreSQL RLS Tenant Isolation</td>
                    <td>0.22s</td>
                    <td>DAST Zero-Trust Auditor</td>
                    <td><span class="tag-pass">PASSED</span></td>
                  </tr>
                  <tr>
                    <td><code>EXEC-8488</code></td>
                    <td><strong>Performance Studio</strong></td>
                    <td>50k req/sec Concurrency Spike</td>
                    <td>2.40s</td>
                    <td>Distributed Node Cluster</td>
                    <td><span class="tag-pass">PASSED</span></td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <!-- VIEW 3: TRACEABILITY & COVERAGE -->
          <div class="view-panel" id="view-traceability">
            <div class="trace-kpis-grid">
              <div class="exec-kpi-card">
                <span class="kpi-label">REQUIREMENT COVERAGE</span>
                <span class="kpi-num" style="color: #0877E8;">98.6%</span>
                <span class="kpi-sub">Target: 95.0% (+3.6% ahead)</span>
              </div>
              <div class="exec-kpi-card">
                <span class="kpi-label">USER STORY COVERAGE</span>
                <span class="kpi-num" style="color: #08C5E8;">99.2%</span>
                <span class="kpi-sub">124 of 125 INVEST stories</span>
              </div>
              <div class="exec-kpi-card">
                <span class="kpi-label">TRACEABILITY INTEGRITY</span>
                <span class="kpi-num" style="color: #10B981;">100%</span>
                <span class="kpi-sub">Zero orphan requirements</span>
              </div>
              <div class="exec-kpi-card">
                <span class="kpi-label">UNCOVERED CRITERIA GAPS</span>
                <span class="kpi-num" style="color: #10B981;">0</span>
                <span class="kpi-sub">Resolved automatically by AI</span>
              </div>
            </div>

            <!-- Testing Type Coverage Distribution -->
            <div class="exec-table-card" style="margin-top: 16px;">
              <div class="table-header-row">
                <span class="th-title">Testing Type Coverage Distribution</span>
                <span class="th-badge" style="color: #0877E8; background: #EFF6FF;">Multi-Tier Active</span>
              </div>
              <div class="distribution-bars">
                <div class="dist-row">
                  <div class="dist-labels">
                    <span>Manual Exploratory Testing</span>
                    <strong>90% Covered</strong>
                  </div>
                  <div class="bar-track"><div class="bar-fill" style="width: 90%; background: #0877E8;"></div></div>
                </div>
                <div class="dist-row">
                  <div class="dist-labels">
                    <span>Playwright &amp; Mobile E2E UI</span>
                    <strong>94% Covered</strong>
                  </div>
                  <div class="bar-track"><div class="bar-fill" style="width: 94%; background: #08C5E8;"></div></div>
                </div>
                <div class="dist-row">
                  <div class="dist-labels">
                    <span>REST, gRPC &amp; GraphQL API Contracts</span>
                    <strong>98% Covered</strong>
                  </div>
                  <div class="bar-track"><div class="bar-fill" style="width: 98%; background: #10B981;"></div></div>
                </div>
              </div>
            </div>
          </div>

          <!-- VIEW 4: DEFECT DECISION CENTER -->
          <div class="view-panel" id="view-defects">
            <div class="exec-table-card">
              <div class="table-header-row">
                <span class="th-title">Defect Decision Center &bull; Real-Time Triage</span>
                <div class="defect-filter-pills">
                  <span class="df-pill active">All Types (14)</span>
                  <span class="df-pill">Functional</span>
                  <span class="df-pill">ETL Pipeline</span>
                  <span class="df-pill">API</span>
                  <span class="df-pill">Security</span>
                </div>
              </div>
              <table class="app-table">
                <thead>
                  <tr>
                    <th>Defect ID</th>
                    <th>Severity</th>
                    <th>Root Cause Diagnostics</th>
                    <th>Origin Studio</th>
                    <th>Self-Healing Action</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td><code>DEF-104</code></td>
                    <td><span class="badge-amber">HIGH</span></td>
                    <td>Shadow-DOM locator drift on <code>#pay-checkout-v2</code></td>
                    <td>Automation Studio</td>
                    <td><span class="tag-pass">AUTO-HEALED (14ms)</span></td>
                  </tr>
                  <tr>
                    <td><code>DEF-103</code></td>
                    <td><span class="badge-blue">MEDIUM</span></td>
                    <td>GraphQL schema nullability mismatch on <code>/v2/ledger</code></td>
                    <td>API Testing Studio</td>
                    <td><span class="tag-pass">RESOLVED</span></td>
                  </tr>
                  <tr>
                    <td><code>DEF-102</code></td>
                    <td><span class="badge-red">CRITICAL</span></td>
                    <td>PostgreSQL cross-tenant RLS boundary leakage probe</td>
                    <td>Security Studio</td>
                    <td><span class="tag-pass">BLOCKED &amp; SECURED</span></td>
                  </tr>
                  <tr>
                    <td><code>DEF-101</code></td>
                    <td><span class="badge-blue">MEDIUM</span></td>
