---
const navItems = [
  { name: 'Platform', href: '/platform' },
  {
    name: 'AI Studios',
    href: '/ai-studios',
    children: [
      { name: 'AI Studio', href: '/studios/ai-studio', desc: 'Autonomous discovery, test synthesis & intelligence' },
      { name: 'Automation Studio', href: '/studios/automation', desc: 'Self-healing test execution & dynamic locator engine' },
      { name: 'API Testing Studio', href: '/studios/api-testing', desc: 'Contract verification, payload fuzzing & schema audit' },
      { name: 'ETL / Data Testing', href: '/studios/etl-testing', desc: 'Data warehouse integrity, vector hashing & reconciliation' },
      { name: 'Performance Studio', href: '/studios/performance-testing', desc: 'Predictive bottleneck analysis & load simulation' },
      { name: 'Security Studio', href: '/studios/security-testing', desc: 'Automated DAST, tenant isolation & vulnerability audit' },
      { name: 'Manual Testing Studio', href: '/studios/manual-testing', desc: 'AI-assisted exploratory flows & session replay' }
    ]
  },
  { name: 'Solutions', href: '/solutions' },
  { name: 'Industries', href: '/industries' },
  { name: 'Enterprise', href: '/enterprise' },
  { name: 'Pricing', href: '/pricing' },
  { name: 'Resources', href: '/resources' },
  { name: 'Company', href: '/about' }
];

const currentPath = Astro.url.pathname;
---

<!-- Fixed Corporate Navigation Bar -->
<header class="nav" id="site-nav">
  <div class="container nav-inner">
    <!-- Parent Company Brand: VERIQON TECHNOLOGIES -->
    <a href="/" class="brand" aria-label="VERIQON TECHNOLOGIES Home">
      <div class="brand-mark">
        <svg viewBox="0 0 48 48" fill="none" class="brand-svg">
          <defs>
            <linearGradient id="nb-v" x1="6" y1="8" x2="26" y2="38" gradientUnits="userSpaceOnUse">
              <stop stop-color="#08C5E8" />
              <stop offset="0.6" stop-color="#0877E8" />
              <stop offset="1" stop-color="#0652A8" />
            </linearGradient>
            <linearGradient id="nb-silver" x1="18" y1="8" x2="42" y2="34" gradientUnits="userSpaceOnUse">
              <stop stop-color="#FFFFFF" />
              <stop offset="0.4" stop-color="#E2E8F0" />
              <stop offset="0.8" stop-color="#94A3B8" />
              <stop offset="1" stop-color="#64748B" />
            </linearGradient>
            <linearGradient id="nb-cyan" x1="26" y1="26" x2="44" y2="40" gradientUnits="userSpaceOnUse">
              <stop stop-color="#08C5E8" />
              <stop offset="1" stop-color="#0877E8" />
            </linearGradient>
          </defs>
          <path d="M6 10L16 38L24 22L17 10H6Z" fill="url(#nb-v)" />
          <path d="M16 38L21 16L24 22L16 38Z" fill="#08C5E8" fill-opacity="0.9" />
          <path d="M21 10H37L42 19L36 30H26L30 22H34L37 18L33 14H24L21 10Z" fill="url(#nb-silver)" />
          <path d="M27 25L39 38H45L33 25H27Z" fill="url(#nb-cyan)" />
        </svg>
      </div>
      <div class="brand-text">
        <span class="brand-title">VERIQON</span>
        <span class="brand-sub">TECHNOLOGIES</span>
      </div>
    </a>

    <!-- Desktop Nav Links -->
    <nav class="desktop-nav" aria-label="Primary Navigation">
      <ul class="nav-links">
        {navItems.map((item) => (
          <li class={`nav-item ${item.children ? 'has-dropdown' : ''}`}>
            <a 
              href={item.href} 
              class={`nav-link ${currentPath === item.href || (item.children && currentPath.startsWith('/studios')) ? 'active' : ''}`}
            >
              {item.name}
              {item.children && (
                <svg class="dropdown-chevron" width="10" height="10" viewBox="0 0 12 12" fill="none">
                  <path d="M2.5 4.5L6 8L9.5 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              )}
            </a>
            {item.children && (
              <div class="dropdown-menu">
                <div class="dropdown-header-tag">
                  <span class="tag-dot"></span>
                  <span>VERIQON ONE Specialist Studios</span>
                </div>
                <div class="dropdown-grid">
                  {item.children.map((sub) => (
                    <a href={sub.href} class="dropdown-item">
                      <div class="dropdown-item-title">{sub.name}</div>
                      <div class="dropdown-item-desc">{sub.desc}</div>
                    </a>
                  ))}
                </div>
                <div class="dropdown-footer">
                  <a href="/ai-studios" class="dropdown-view-all">
                    Explore all 7 Studios Overview &rarr;
                  </a>
                </div>
              </div>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <!-- Nav Actions -->
    <div class="nav-actions">
      <a href="/contact" class="nav-sign-in">Contact Sales</a>
      <a href="/request-demo" class="btn btn-primary nav-btn-cta">Request a Demo</a>
      
      <!-- Mobile menu button -->
      <button class="mobile-toggle" id="mobile-menu-btn" aria-label="Toggle navigation menu" aria-expanded="false">
        <svg class="icon-menu" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
        <svg class="icon-close" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Drawer Backdrop -->
<div class="mobile-backdrop" id="mobile-backdrop"></div>

<!-- Mobile Drawer -->
<aside class="mobile-drawer" id="mobile-drawer" aria-label="Mobile Navigation">
  <div class="mobile-drawer-inner">
    <div class="drawer-header-row">
      <div class="drawer-brand">
        <span class="drawer-badge-dot"></span>
        <span class="drawer-title">VERIQON TECHNOLOGIES</span>
      </div>
      <button type="button" class="drawer-close-btn" id="drawer-close-btn" aria-label="Close menu">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>

    <div class="mobile-drawer-content">
      <div class="mobile-group-label">Platform &amp; Products</div>
      <a href="/platform" class="mobile-link">Platform Architecture</a>
      <a href="/ai-studios" class="mobile-link">AI Studios Overview</a>

      <!-- Studios Collapsible Group -->
      <div class="studios-group">
        <button type="button" class="studios-toggle-btn" id="studios-toggle-btn" aria-expanded="true">
          <span>VERIQON ONE Studios (7)</span>
          <svg class="studios-chevron" width="12" height="12" viewBox="0 0 12 12" fill="none">
            <path d="M2.5 4.5L6 8L9.5 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <div class="studios-sublinks" id="studios-sublinks">
          <a href="/studios/ai-studio" class="mobile-sublink">
            <span class="sublink-title">AI Studio</span>
            <span class="sublink-tag">Discovery &amp; Intelligence</span>
          </a>
          <a href="/studios/automation" class="mobile-sublink">
            <span class="sublink-title">Automation Studio</span>
            <span class="sublink-tag">Self-Healing Engine</span>
          </a>
          <a href="/studios/api-testing" class="mobile-sublink">
            <span class="sublink-title">API Testing Studio</span>
            <span class="sublink-tag">Contract &amp; Fuzzing</span>
          </a>
          <a href="/studios/etl-testing" class="mobile-sublink">
            <span class="sublink-title">ETL / Data Testing Studio</span>
            <span class="sublink-tag">Data Warehouse QA</span>
          </a>
          <a href="/studios/performance-testing" class="mobile-sublink">
            <span class="sublink-title">Performance Studio</span>
            <span class="sublink-tag">Predictive Load</span>
          </a>
          <a href="/studios/security-testing" class="mobile-sublink">
            <span class="sublink-title">Security Studio</span>
            <span class="sublink-tag">Automated DAST</span>
          </a>
          <a href="/studios/manual-testing" class="mobile-sublink">
            <span class="sublink-title">Manual Testing Studio</span>
            <span class="sublink-tag">AI-Assisted Exploratory</span>
          </a>
        </div>
      </div>

      <div class="mobile-group-label" style="margin-top: 1.5rem;">Enterprise &amp; Solutions</div>
      <a href="/solutions" class="mobile-link">Enterprise Solutions</a>
      <a href="/industries" class="mobile-link">Industry Verticals</a>
      <a href="/enterprise" class="mobile-link">Enterprise Trust &amp; Architecture</a>
      <a href="/pricing" class="mobile-link">Pricing &amp; Deployment Plans</a>

      <div class="mobile-group-label" style="margin-top: 1.5rem;">Corporate &amp; Resources</div>
      <a href="/about" class="mobile-link">About VERIQON TECHNOLOGIES</a>
      <a href="/resources" class="mobile-link">Technical Documentation &amp; Insights</a>
      <a href="/contact" class="mobile-link">Contact Enterprise Sales</a>

      <div class="mobile-drawer-cta">
        <a href="/request-demo" class="btn btn-primary" style="width: 100%;">Request a Demo</a>
        <a href="/platform" class="btn btn-secondary" style="width: 100%;">Explore VERIQON ONE</a>
      </div>
    </div>
  </div>
</aside>

<style>
  /* Fixed Corporate Navigation Bar */
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    z-index: 1100;
    background: #061B36;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 4px 20px rgba(6, 27, 54, 0.25);
  }

  .nav-inner {
    min-height: var(--nav-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  /* Brand */
  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
    flex-shrink: 0;
  }

  .brand-mark {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(8, 197, 232, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6px;
    flex-shrink: 0;
  }

  .brand-svg {
    width: 100%;
    height: 100%;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .brand-title {
    font-size: 18px;
    font-weight: 800;
    letter-spacing: 0.05em;
    color: #FFFFFF;
  }

  .brand-sub {
    font-size: 9.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--cyan);
    font-weight: 700;
  }

  /* Desktop Nav Links */
  .desktop-nav {
    display: flex;
    align-items: center;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 4px;
    list-style: none;
  }

  .nav-item {
    position: relative;
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 8px 12px;
    border-radius: 8px;
    color: #C7D0DA;
    font-size: 14px;
    font-weight: 600;
    transition: all 0.18s ease;
  }

  .nav-link:hover, .nav-link.active {
    color: #FFFFFF;
    background: rgba(255, 255, 255, 0.08);
  }

  .dropdown-chevron {
    transition: transform 0.2s ease;
    color: #C7D0DA;
  }

  .has-dropdown:hover .dropdown-chevron {
    transform: rotate(180deg);
    color: var(--cyan);
  }

  /* Dropdown Menu */
  .dropdown-menu {
    position: absolute;
    top: calc(100% + 8px);
    left: -20px;
    width: 540px;
    padding: 16px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition: opacity 0.2s cubic-bezier(0.16, 1, 0.3, 1), transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: none;
    border-radius: var(--radius-md);
    background: #0A2547;
    border: 1px solid rgba(8, 197, 232, 0.25);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.6);
    z-index: 200;
  }

  .dropdown-menu::before {
    content: '';
    position: absolute;
    top: -10px;
    left: 0;
    right: 0;
    height: 10px;
  }

  .has-dropdown:hover .dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    pointer-events: auto;
  }

  .dropdown-header-tag {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--cyan);
    margin-bottom: 12px;
    padding-bottom: 8px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .tag-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--cyan);
  }

  .dropdown-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 6px;
  }

  .dropdown-item {
    padding: 10px 12px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid transparent;
    transition: all 0.18s ease;
  }

  .dropdown-item:hover {
    background: rgba(8, 119, 232, 0.18);
    border-color: rgba(8, 197, 232, 0.35);
    transform: translateY(-1px);
  }

  .dropdown-item-title {
    font-size: 13.5px;
    font-weight: 650;
    color: #FFFFFF;
  }

  .dropdown-item-desc {
    font-size: 11.5px;
    color: #C7D0DA;
    margin-top: 3px;
    line-height: 1.35;
  }

  .dropdown-footer {
    margin-top: 10px;
    padding-top: 10px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    text-align: right;
  }

  .dropdown-view-all {
    font-size: 12.5px;
    font-weight: 650;
    color: var(--cyan);
  }

  .dropdown-view-all:hover {
    text-decoration: underline;
  }

  /* Right-side Nav Actions */
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }

  .nav-sign-in {
    font-size: 14px;
    font-weight: 600;
    color: #C7D0DA;
    padding: 8px 12px;
    border-radius: 8px;
    transition: color 0.18s ease;
  }

  .nav-sign-in:hover {
    color: #FFFFFF;
  }

  .nav-btn-cta {
    padding: 9px 18px;
    font-size: 13.5px;
    border-radius: 10px;
  }

  .mobile-toggle {
    display: none;
    background: transparent;
    border: none;
    color: #FFFFFF;
    cursor: pointer;
    padding: 8px;
  }

  .icon-close { display: none; }
  .mobile-backdrop { display: none; }
  .mobile-drawer { display: none; }

  /* Tablet & Mobile Breakpoints */
  @media (max-width: 1180px) {
    .desktop-nav,
    .nav-sign-in {
      display: none;
    }

    .mobile-toggle {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 42px;
      height: 42px;
      border-radius: 10px;
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.15);
      color: #FFFFFF;
      cursor: pointer;
    }

    .mobile-backdrop {
      display: block;
      position: fixed;
      top: var(--nav-h);
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(6, 27, 54, 0.85);
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transition: opacity 0.25s ease, visibility 0.25s ease;
      z-index: 1099;
      touch-action: none;
    }

    .mobile-backdrop.open {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }

    .mobile-drawer {
      display: block;
      position: fixed;
      top: var(--nav-h);
      right: 0;
      width: min(390px, 100vw);
      height: calc(100vh - var(--nav-h));
      height: calc(100dvh - var(--nav-h));
      background: #0A2547;
      border-left: 1px solid rgba(8, 197, 232, 0.25);
      box-shadow: -14px 0 44px rgba(0, 0, 0, 0.7);
      transform: translateX(100%);
      transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);
      overflow-y: auto;
      overflow-x: hidden;
      -webkit-overflow-scrolling: touch;
      touch-action: pan-y;
      overscroll-behavior: contain;
      z-index: 1100;
    }

    .mobile-drawer.open {
      transform: translateX(0);
    }

    .mobile-drawer-inner {
      display: flex;
      flex-direction: column;
      min-height: 100%;
    }

    .drawer-header-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 16px 20px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      background: rgba(6, 27, 54, 0.5);
    }

    .drawer-brand {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .drawer-badge-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--cyan);
      box-shadow: 0 0 8px var(--cyan);
    }

    .drawer-title {
      font-size: 13px;
      font-weight: 750;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #FFFFFF;
    }

    .drawer-close-btn {
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.16);
      border-radius: 8px;
      color: #C7D0DA;
      cursor: pointer;
      padding: 6px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .mobile-drawer-content {
      padding: 1.25rem 1.25rem 6.5rem;
      display: flex;
      flex-direction: column;
    }

    .mobile-group-label {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.14em;
      color: var(--cyan);
      font-weight: 750;
      margin-top: 1.25rem;
      margin-bottom: 0.5rem;
    }

    .mobile-link {
      display: flex;
      align-items: center;
      min-height: 44px;
      padding: 10px 12px;
      border-radius: 8px;
      font-size: 15px;
      color: #E8EEF5;
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
      touch-action: manipulation;
      transition: background 0.15s ease, color 0.15s ease;
    }

    .mobile-link:active,
    .mobile-link:hover {
      background: rgba(255, 255, 255, 0.08);
      color: #FFFFFF;
    }

    /* Studios Collapsible */
    .studios-group {
      margin-top: 8px;
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 10px;
      overflow: hidden;
    }

    .studios-toggle-btn {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px 14px;
      background: transparent;
      border: none;
      color: #FFFFFF;
      font-size: 14px;
      font-weight: 650;
      cursor: pointer;
      touch-action: manipulation;
    }

    .studios-chevron {
      transition: transform 0.2s ease;
      color: var(--cyan);
    }

    .studios-toggle-btn[aria-expanded="true"] .studios-chevron {
      transform: rotate(180deg);
    }

    .studios-sublinks {
      display: flex;
      flex-direction: column;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
    }

    .studios-sublinks.collapsed {
      display: none;
    }

    .mobile-sublink {
      display: flex;
      flex-direction: column;
      padding: 10px 14px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    }

    .mobile-sublink:last-child {
      border-bottom: none;
    }

    .mobile-sublink:hover,
    .mobile-sublink:active {
      background: rgba(8, 119, 232, 0.15);
    }

    .sublink-title {
      font-size: 13.5px;
      font-weight: 650;
      color: #FFFFFF;
    }

    .sublink-tag {
      font-size: 11px;
      color: var(--cyan);
      margin-top: 2px;
      font-family: var(--font-mono);
    }

    .mobile-drawer-cta {
      margin-top: 2rem;
      padding-top: 1.5rem;
      border-top: 1px solid rgba(255, 255, 255, 0.1);
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
  }

  @media (max-width: 640px) {
    .nav-btn-cta {
      padding: 8px 14px;
      font-size: 12.5px;
    }

    .brand-sub {
      display: none;
    }

    .brand-title {
      font-size: 16px;
    }

    .brand-mark {
      width: 34px;
      height: 34px;
      padding: 4px;
    }

    .mobile-drawer {
      width: 100vw;
      border-left: none;
    }
  }
</style>

<script>
  const toggleBtn = document.getElementById('mobile-menu-btn');
  const drawer = document.getElementById('mobile-drawer');
  const backdrop = document.getElementById('mobile-backdrop');
  const drawerCloseBtn = document.getElementById('drawer-close-btn');
  const mobileLinks = document.querySelectorAll('.mobile-link, .mobile-sublink, .mobile-drawer-cta a');
  const studiosToggle = document.getElementById('studios-toggle-btn');
  const studiosList = document.getElementById('studios-sublinks');

  function setDrawerOpen(open: boolean) {
    if (!toggleBtn || !drawer || !backdrop) return;
    toggleBtn.setAttribute('aria-expanded', open.toString());
    drawer.classList.toggle('open', open);
    backdrop.classList.toggle('open', open);

    if (open) {
      document.documentElement.style.overflow = 'hidden';
      document.body.style.overflow = 'hidden';
      document.body.style.touchAction = 'none';
    } else {
      document.documentElement.style.overflow = '';
      document.body.style.overflow = '';
      document.body.style.touchAction = '';
    }

    const menuIcon = toggleBtn.querySelector('.icon-menu') as HTMLElement;
    const closeIcon = toggleBtn.querySelector('.icon-close') as HTMLElement;
    if (menuIcon && closeIcon) {
      menuIcon.style.display = open ? 'none' : 'block';
      closeIcon.style.display = open ? 'block' : 'none';
    }
  }

  if (toggleBtn && drawer && backdrop) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      setDrawerOpen(!isExpanded);
    });

    if (drawerCloseBtn) {
      drawerCloseBtn.addEventListener('click', () => {
        setDrawerOpen(false);
      });
    }

    backdrop.addEventListener('click', () => {
      setDrawerOpen(false);
    });

    mobileLinks.forEach((link) => {
      link.addEventListener('click', () => {
        setDrawerOpen(false);
      });
    });

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && drawer.classList.contains('open')) {
        setDrawerOpen(false);
      }
    });

    window.addEventListener('resize', () => {
      if (window.innerWidth > 1180 && drawer.classList.contains('open')) {
        setDrawerOpen(false);
      }
    });
  }

  // Studios Accordion toggle inside drawer
  if (studiosToggle && studiosList) {
    studiosToggle.addEventListener('click', () => {
      const isExpanded = studiosToggle.getAttribute('aria-expanded') === 'true';
      studiosToggle.setAttribute('aria-expanded', (!isExpanded).toString());
      studiosList.classList.toggle('collapsed', isExpanded);
    });
  }
</script>
