---
const pathname = Astro.url.pathname;

const navLinks = [
  { name: 'Platform', href: '/platform' },
  { 
    name: 'Studios', 
    href: '/platform#studios',
    children: [
      { name: 'AI End-to-End Studio', href: '/studios/ai-end-to-end', desc: 'Autonomous discovery to synthesis' },
      { name: 'Automation Studio', href: '/studios/automation', desc: 'Self-healing test execution engine' },
      { name: 'ETL Testing Studio', href: '/studios/etl-testing', desc: 'Data warehouse & pipeline validation' },
      { name: 'Performance Studio', href: '/studios/performance-testing', desc: 'Predictive bottleneck analysis' },
      { name: 'Security Studio', href: '/studios/security-testing', desc: 'Automated DAST & threat modeling' },
      { name: 'Manual Testing Studio', href: '/studios/manual-testing', desc: 'AI-assisted exploratory flows' }
    ]
  },
  { name: 'Features', href: '/features' },
  { name: 'Solutions', href: '/solutions' },
  { name: 'Pricing', href: '/pricing' },
  { name: 'About', href: '/about' },
  { name: 'Resources', href: '/resources' },
];
---

<header class="nav">
  <div class="container nav-inner">
    <a href="/" class="brand" aria-label="Valtrix AI Home">
      <div class="brand-mark">
        <svg viewBox="0 0 32 32" fill="none" class="brand-svg">
          <path d="M16 3L27 8V17C27 24 21 28.5 16 30C11 28.5 5 24 5 17V8L16 3Z" fill="url(#brand-grad)" fill-opacity="0.3" stroke="url(#brand-stroke)" stroke-width="1.5" />
          <path d="M10 11L16 23L22 11H18.5L16 16.5L13.5 11H10Z" fill="#ffffff" />
          <defs>
            <linearGradient id="brand-grad" x1="0" y1="0" x2="32" y2="32">
              <stop stop-color="#61adff" />
              <stop offset="0.5" stop-color="#9d7dff" />
              <stop offset="1" stop-color="#ff6fd7" />
            </linearGradient>
            <linearGradient id="brand-stroke" x1="0" y1="0" x2="32" y2="32">
              <stop stop-color="#79f3ff" />
              <stop offset="1" stop-color="#9d7dff" />
            </linearGradient>
          </defs>
        </svg>
      </div>
      <div class="brand-text">
        <span class="brand-title">Valtrix AI</span>
        <span class="brand-sub">Intelligence Systems</span>
      </div>
    </a>

    <!-- Desktop Nav Links -->
    <nav class="desktop-nav" aria-label="Primary">
      <ul class="nav-links">
        {navLinks.map((item) => (
          <li class={`nav-item ${item.children ? 'has-dropdown' : ''}`}>
            <a 
              href={item.href} 
              class={`nav-link ${pathname === item.href ? 'active' : ''}`}
            >
              {item.name}
              {item.children && (
                <svg class="dropdown-chevron" width="10" height="10" viewBox="0 0 12 12" fill="none">
                  <path d="M2.5 4.5L6 8L9.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              )}
            </a>
            {item.children && (
              <div class="dropdown-menu">
                <div class="dropdown-grid">
                  {item.children.map((sub) => (
                    <a href={sub.href} class="dropdown-item">
                      <div class="dropdown-item-title">{sub.name}</div>
                      <div class="dropdown-item-desc">{sub.desc}</div>
                    </a>
                  ))}
                </div>
              </div>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <!-- Nav Actions -->
    <div class="nav-actions">
      <a href="/contact" class="btn btn-secondary nav-btn-secondary">Schedule Walkthrough</a>
      <a href="/platform" class="btn btn-primary nav-btn-primary">Explore Platform</a>
      
      <!-- Mobile menu button -->
      <button class="mobile-toggle" id="mobile-menu-btn" aria-label="Toggle navigation menu" aria-expanded="false">
        <svg class="icon-menu" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
        <svg class="icon-close" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer -->
  <div class="mobile-drawer" id="mobile-drawer">
    <div class="mobile-drawer-content">
      <div class="mobile-group-label">Core Platform</div>
      <a href="/platform" class="mobile-link">Platform Architecture</a>
      <a href="/studios/ai-end-to-end" class="mobile-link">AI End-to-End Studio</a>
      <a href="/studios/automation" class="mobile-link">Automation Studio</a>
      <a href="/studios/etl-testing" class="mobile-link">ETL Testing Studio</a>
      <a href="/studios/performance-testing" class="mobile-link">Performance Testing Studio</a>
      <a href="/studios/security-testing" class="mobile-link">Security Testing Studio</a>
      <a href="/studios/manual-testing" class="mobile-link">Manual Testing Studio</a>

      <div class="mobile-group-label">Enterprise &amp; Company</div>
      <a href="/features" class="mobile-link">Features Matrix</a>
      <a href="/solutions" class="mobile-link">Industry Solutions</a>
      <a href="/pricing" class="mobile-link">Pricing &amp; Tiers</a>
      <a href="/about" class="mobile-link">About Valtrix</a>
      <a href="/resources" class="mobile-link">Technical Guides</a>
      <a href="/contact" class="mobile-link">Contact</a>

      <div style="margin-top: 2rem;">
        <a href="/contact" class="btn btn-primary" style="width: 100%;">Request Private Demo</a>
      </div>
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(7, 17, 29, 0.78);
    border-bottom: 1px solid var(--stroke);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }

  .nav-inner {
    min-height: var(--nav-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 14px;
    min-width: 0;
  }

  .brand-mark {
    width: 44px;
    height: 44px;
    border-radius: 14px;
    position: relative;
    overflow: hidden;
    flex: 0 0 auto;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: radial-gradient(circle at 28% 24%, rgba(97, 173, 255, 0.28), rgba(157, 125, 255, 0.22) 55%, rgba(255, 111, 215, 0.16) 100%), #0d1629;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
  }

  .brand-svg {
    width: 100%;
    height: 100%;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .brand-title {
    font-size: 19px;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--text);
  }

  .brand-sub {
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--cyan);
    font-weight: 600;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 4px;
    list-style: none;
  }

  .nav-item {
    position: relative;
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 16px;
    border-radius: 999px;
    color: var(--muted);
    font-size: 14px;
    font-weight: 550;
    transition: all 0.2s ease;
  }

  .nav-link:hover, .nav-link.active {
    color: var(--text);
    background: rgba(255, 255, 255, 0.06);
  }

  .dropdown-chevron {
    transition: transform 0.2s ease;
  }

  .has-dropdown:hover .dropdown-chevron {
    transform: rotate(180deg);
  }

  .dropdown-menu {
    position: absolute;
    top: calc(100% + 10px);
    left: -20px;
    width: 500px;
    padding: 16px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition: opacity 0.2s cubic-bezier(0.16, 1, 0.3, 1), transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: none;
    border-radius: var(--radius-md);
    background: #091322;
    background: linear-gradient(180deg, #0e1c31 0%, #07111f 100%);
    border: 1px solid rgba(255, 255, 255, 0.18);
    box-shadow: 0 28px 70px rgba(0, 0, 0, 0.88), 0 0 40px rgba(97, 173, 255, 0.16);
    z-index: 200;
  }

  .dropdown-menu::before {
    content: '';
    position: absolute;
    top: -12px;
    left: 0;
    right: 0;
    height: 12px;
  }

  .has-dropdown:hover .dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    pointer-events: auto;
  }

  .dropdown-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 8px;
  }

  .dropdown-item {
    padding: 12px 14px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.035);
    border: 1px solid transparent;
    transition: all 0.18s ease;
  }

  .dropdown-item:hover {
    background: rgba(97, 173, 255, 0.14);
    border-color: rgba(121, 243, 255, 0.3);
    transform: translateY(-1px);
  }

  .dropdown-item-title {
    font-size: 14px;
    font-weight: 600;
    color: var(--text);
  }

  .dropdown-item-desc {
    font-size: 12px;
    color: var(--muted);
    margin-top: 3px;
    line-height: 1.4;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .nav-btn-secondary {
    padding: 10px 18px;
    font-size: 13px;
    border-radius: 14px;
  }

  .nav-btn-primary {
    padding: 10px 20px;
    font-size: 13px;
    border-radius: 14px;
  }

  .mobile-toggle {
    display: none;
    background: transparent;
    border: none;
    color: var(--text);
    cursor: pointer;
    padding: 6px;
  }

  .icon-close { display: none; }
  .mobile-drawer { display: none; }

  @media (max-width: 1060px) {
    .desktop-nav, .nav-btn-secondary {
      display: none;
    }

    .mobile-toggle {
      display: block;
    }

    .mobile-drawer {
      display: block;
      position: fixed;
      top: var(--nav-h);
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(7, 17, 29, 0.98);
      transform: translateX(100%);
      transition: transform 0.3s cubic-bezier(0.22, 0.8, 0.18, 1);
      overflow-y: auto;
      z-index: 99;
    }

    .mobile-drawer.open {
      transform: translateX(0);
    }

    .mobile-drawer-content {
      padding: 2.5rem 1.5rem;
    }

    .mobile-group-label {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.15em;
      color: var(--cyan);
      font-weight: 700;
      margin-top: 1.75rem;
      margin-bottom: 0.75rem;
    }

    .mobile-link {
      display: block;
      padding: 12px 0;
      font-size: 16px;
      color: var(--muted);
      border-bottom: 1px solid var(--stroke);
    }
  }
</style>

<script>
  const toggleBtn = document.getElementById('mobile-menu-btn');
  const drawer = document.getElementById('mobile-drawer');

  if (toggleBtn && drawer) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', (!isExpanded).toString());
      drawer.classList.toggle('open');
      
      const menuIcon = toggleBtn.querySelector('.icon-menu') as HTMLElement;
      const closeIcon = toggleBtn.querySelector('.icon-close') as HTMLElement;
      if (menuIcon && closeIcon) {
        menuIcon.style.display = isExpanded ? 'block' : 'none';
        closeIcon.style.display = isExpanded ? 'none' : 'block';
      }
    });
  }
</script>
