---
const navItems = [
  { name: 'Platform', href: '/platform' },
  {
    name: 'Studios',
    href: '/platform#studios',
    children: [
      { name: 'AI End-to-End Studio', href: '/studios/ai-end-to-end', desc: 'Autonomous discovery to synthesis' },
      { name: 'Automation Studio', href: '/studios/automation', desc: 'Self-healing test execution engine' },
      { name: 'ETL Testing Studio', href: '/studios/etl-testing', desc: 'Data warehouse & pipeline validation' },
      { name: 'Performance Studio', href: '/studios/performance-testing', desc: 'Predictive bottleneck analysis' },
      { name: 'Security Studio', href: '/studios/security-testing', desc: 'Automated DAST & threat modeling' },
      { name: 'Manual Testing Studio', href: '/studios/manual-testing', desc: 'AI-assisted exploratory flows' }
    ]
  },
  { name: 'Features', href: '/features' },
  { name: 'Solutions', href: '/solutions' },
  { name: 'Pricing', href: '/pricing' },
  { name: 'About', href: '/about' },
  { name: 'Resources', href: '/resources' }
];

const currentPath = Astro.url.pathname;
---

<!-- Fixed Top Navigation Bar (Always Visible at Top of Screen) -->
<header class="nav" id="site-nav">
  <div class="container nav-inner">
    <!-- Brand -->
    <a href="/" class="brand" aria-label="Valtrix AI Home">
      <div class="brand-mark">
        <svg viewBox="0 0 32 32" fill="none" class="brand-svg">
          <path d="M16 3L27 8V17C27 24 21 28.5 16 30C11 28.5 5 24 5 17V8L16 3Z" fill="url(#brand-grad)" fill-opacity="0.3" stroke="url(#brand-stroke)" stroke-width="1.5" />
          <path d="M10 11L16 23L22 11H18.5L16 16.5L13.5 11H10Z" fill="#ffffff" />
          <defs>
            <linearGradient id="brand-grad" x1="0" y1="0" x2="32" y2="32">
              <stop stop-color="#61adff" />
              <stop offset="0.5" stop-color="#9d7dff" />
              <stop offset="1" stop-color="#ff6fd7" />
            </linearGradient>
            <linearGradient id="brand-stroke" x1="0" y1="0" x2="32" y2="32">
              <stop stop-color="#79f3ff" />
              <stop offset="1" stop-color="#9d7dff" />
            </linearGradient>
          </defs>
        </svg>
      </div>
      <div class="brand-text">
        <span class="brand-title">Valtrix AI</span>
        <span class="brand-sub">Intelligence Systems</span>
      </div>
    </a>

    <!-- Desktop Nav Links -->
    <nav class="desktop-nav" aria-label="Primary">
      <ul class="nav-links">
        {navItems.map((item) => (
          <li class={`nav-item ${item.children ? 'has-dropdown' : ''}`}>
            <a 
              href={item.href} 
              class={`nav-link ${currentPath === item.href ? 'active' : ''}`}
            >
              {item.name}
              {item.children && (
                <svg class="dropdown-chevron" width="10" height="10" viewBox="0 0 12 12" fill="none">
                  <path d="M2.5 4.5L6 8L9.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              )}
            </a>
            {item.children && (
              <div class="dropdown-menu">
                <div class="dropdown-grid">
                  {item.children.map((sub) => (
                    <a href={sub.href} class="dropdown-item">
                      <div class="dropdown-item-title">{sub.name}</div>
                      <div class="dropdown-item-desc">{sub.desc}</div>
                    </a>
                  ))}
                </div>
              </div>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <!-- Nav Actions -->
    <div class="nav-actions">
      <a href="/contact" class="btn btn-secondary nav-btn-secondary">Schedule Walkthrough</a>
      <a href="/platform" class="btn btn-primary nav-btn-primary">Explore Platform</a>
      
      <!-- Mobile menu button (always fixed and visible) -->
      <button class="mobile-toggle" id="mobile-menu-btn" aria-label="Toggle navigation menu" aria-expanded="false">
        <svg class="icon-menu" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
        <svg class="icon-close" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Drawer Backdrop -->
<div class="mobile-backdrop" id="mobile-backdrop"></div>

<!-- Mobile Drawer (Clean, Accessible, Scrollable) -->
<aside class="mobile-drawer" id="mobile-drawer" aria-label="Mobile Navigation">
  <div class="mobile-drawer-inner">
    <!-- Drawer Header with Title and Close Action -->
    <div class="drawer-header-row">
      <div class="drawer-brand">
        <span class="drawer-badge-dot"></span>
        <span class="drawer-title">Navigation Menu</span>
      </div>
      <button type="button" class="drawer-close-btn" id="drawer-close-btn" aria-label="Close menu">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>

    <div class="mobile-drawer-content">
      <!-- Main Overview -->
      <div class="mobile-group-label">Architecture</div>
      <a href="/platform" class="mobile-link">Platform Architecture</a>

      <!-- Studios Collapsible Group -->
      <div class="studios-group">
        <button type="button" class="studios-toggle-btn" id="studios-toggle-btn" aria-expanded="true">
          <span>Quality Studios (6)</span>
          <svg class="studios-chevron" width="12" height="12" viewBox="0 0 12 12" fill="none">
            <path d="M2.5 4.5L6 8L9.5 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <div class="studios-sublinks" id="studios-sublinks">
          <a href="/studios/ai-end-to-end" class="mobile-sublink">
            <span class="sublink-title">AI End-to-End Studio</span>
            <span class="sublink-tag">Autonomous Synthesis</span>
          </a>
          <a href="/studios/automation" class="mobile-sublink">
            <span class="sublink-title">Automation Studio</span>
            <span class="sublink-tag">Self-Healing Engine</span>
          </a>
          <a href="/studios/etl-testing" class="mobile-sublink">
            <span class="sublink-title">ETL Testing Studio</span>
            <span class="sublink-tag">Data Warehouses</span>
          </a>
          <a href="/studios/performance-testing" class="mobile-sublink">
            <span class="sublink-title">Performance Studio</span>
            <span class="sublink-tag">Predictive Load</span>
          </a>
          <a href="/studios/security-testing" class="mobile-sublink">
            <span class="sublink-title">Security Studio</span>
            <span class="sublink-tag">Automated DAST</span>
          </a>
          <a href="/studios/manual-testing" class="mobile-sublink">
            <span class="sublink-title">Manual Testing Studio</span>
            <span class="sublink-tag">AI-Assisted Exploratory</span>
          </a>
        </div>
      </div>

      <!-- Enterprise & Company -->
      <div class="mobile-group-label" style="margin-top: 1.5rem;">Enterprise &amp; Solutions</div>
      <a href="/features" class="mobile-link">Features Matrix</a>
      <a href="/solutions" class="mobile-link">Industry Solutions</a>
      <a href="/pricing" class="mobile-link">Pricing &amp; Engagements</a>

      <div class="mobile-group-label" style="margin-top: 1.5rem;">Company &amp; Resources</div>
      <a href="/about" class="mobile-link">About Valtrix</a>
      <a href="/resources" class="mobile-link">Technical Guides</a>
      <a href="/contact" class="mobile-link">Contact Engineering</a>

      <!-- Quick Action Buttons -->
      <div class="mobile-drawer-cta">
        <a href="/contact" class="btn btn-primary" style="width: 100%;">Schedule Walkthrough</a>
        <a href="/platform" class="btn btn-secondary" style="width: 100%;">Explore Platform</a>
      </div>
    </div>
  </div>
</aside>

<style>
  /* Fixed Header: Guaranteed visible on desktop, tablet, and mobile regardless of scroll */
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    z-index: 1100;
    background: rgba(7, 17, 29, 0.88);
    border-bottom: 1px solid var(--stroke);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }

  .nav-inner {
    min-height: var(--nav-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  /* Brand */
  .brand {
    display: flex;
    align-items: center;
    gap: 14px;
    min-width: 0;
    flex-shrink: 0;
  }

  .brand-mark {
    width: 44px;
    height: 44px;
    border-radius: 14px;
    position: relative;
    overflow: hidden;
    flex: 0 0 auto;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: radial-gradient(circle at 28% 24%, rgba(97, 173, 255, 0.28), rgba(157, 125, 255, 0.22) 55%, rgba(255, 111, 215, 0.16) 100%), #0d1629;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
  }

  .brand-svg {
    width: 100%;
    height: 100%;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .brand-title {
    font-size: 19px;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--text);
  }

  .brand-sub {
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--cyan);
    font-weight: 600;
  }

  /* Desktop Navigation */
  .desktop-nav {
    display: flex;
    align-items: center;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 4px;
    list-style: none;
  }

  .nav-item {
    position: relative;
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 14px;
    border-radius: 999px;
    color: var(--muted);
    font-size: 14px;
    font-weight: 550;
    transition: all 0.2s ease;
  }

  .nav-link:hover, .nav-link.active {
    color: var(--text);
    background: rgba(255, 255, 255, 0.06);
  }

  .dropdown-chevron {
    transition: transform 0.2s ease;
  }

  .has-dropdown:hover .dropdown-chevron {
    transform: rotate(180deg);
  }

  /* Desktop Dropdown Menu */
  .dropdown-menu {
    position: absolute;
    top: calc(100% + 10px);
    left: -20px;
    width: 500px;
    padding: 16px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition: opacity 0.2s cubic-bezier(0.16, 1, 0.3, 1), transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: none;
    border-radius: var(--radius-md);
    background: #091322;
    background: linear-gradient(180deg, #0e1c31 0%, #07111f 100%);
    border: 1px solid rgba(255, 255, 255, 0.18);
    box-shadow: 0 28px 70px rgba(0, 0, 0, 0.88), 0 0 40px rgba(97, 173, 255, 0.16);
    z-index: 200;
  }

  .dropdown-menu::before {
    content: '';
    position: absolute;
    top: -12px;
    left: 0;
    right: 0;
    height: 12px;
  }

  .has-dropdown:hover .dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    pointer-events: auto;
  }

  .dropdown-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 8px;
  }

  .dropdown-item {
    padding: 12px 14px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.035);
    border: 1px solid transparent;
    transition: all 0.18s ease;
  }

  .dropdown-item:hover {
    background: rgba(97, 173, 255, 0.14);
    border-color: rgba(121, 243, 255, 0.3);
    transform: translateY(-1px);
  }

  .dropdown-item-title {
    font-size: 14px;
    font-weight: 600;
    color: var(--text);
  }

  .dropdown-item-desc {
    font-size: 12px;
    color: var(--muted);
    margin-top: 3px;
    line-height: 1.4;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }

  .nav-btn-secondary {
    padding: 10px 18px;
    font-size: 13px;
    border-radius: 14px;
  }

  .nav-btn-primary {
    padding: 10px 20px;
    font-size: 13px;
    border-radius: 14px;
  }

  .mobile-toggle {
    display: none;
    background: transparent;
    border: none;
    color: var(--text);
    cursor: pointer;
    padding: 8px;
  }

  .icon-close { display: none; }
  .mobile-backdrop { display: none; }
  .mobile-drawer { display: none; }

  /* Mobile and Tablet Breakpoints */
  @media (max-width: 1140px) {
    .nav {
      background: #07111d;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }

    .desktop-nav, 
    .nav-btn-secondary {
      display: none;
    }

    .mobile-toggle {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      border-radius: 12px;
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid var(--stroke);
      color: var(--text);
      cursor: pointer;
      touch-action: manipulation;
    }

    .mobile-backdrop {
      display: block;
      position: fixed;
      top: var(--nav-h);
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(0, 0, 0, 0.76);
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transition: opacity 0.25s ease, visibility 0.25s ease;
      z-index: 1099;
      touch-action: none;
    }

    .mobile-backdrop.open {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }

    .mobile-drawer {
      display: block;
      position: fixed;
      top: var(--nav-h);
      right: 0;
      width: min(390px, 100vw);
      height: calc(100vh - var(--nav-h));
      height: calc(100dvh - var(--nav-h));
      background: #08111e;
      border-left: 1px solid var(--stroke-strong);
      box-shadow: -14px 0 44px rgba(0, 0, 0, 0.8);
      transform: translateX(100%);
      transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);
      overflow-y: auto;
      overflow-x: hidden;
      -webkit-overflow-scrolling: touch;
      touch-action: pan-y;
      overscroll-behavior: contain;
      z-index: 1100;
    }

    .mobile-drawer.open {
      transform: translateX(0);
    }

    .mobile-drawer-inner {
      display: flex;
      flex-direction: column;
      min-height: 100%;
    }

    .drawer-header-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 16px 20px;
      border-bottom: 1px solid var(--stroke);
      background: rgba(255, 255, 255, 0.02);
    }

    .drawer-brand {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .drawer-badge-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--cyan);
      box-shadow: 0 0 8px var(--cyan);
    }

    .drawer-title {
      font-size: 13px;
      font-weight: 650;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--cyan);
    }

    .drawer-close-btn {
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid var(--stroke);
      border-radius: 8px;
      color: var(--muted);
      cursor: pointer;
      padding: 6px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .mobile-drawer-content {
      padding: 1.25rem 1.25rem 6.5rem;
      display: flex;
      flex-direction: column;
    }

    .mobile-group-label {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.14em;
      color: var(--muted2);
      font-weight: 700;
      margin-top: 1rem;
      margin-bottom: 0.5rem;
    }

    .mobile-link {
      display: flex;
      align-items: center;
      min-height: 44px;
      padding: 10px 12px;
      border-radius: 10px;
      font-size: 15px;
      color: var(--muted);
      border-bottom: 1px solid rgba(255, 255, 255, 0.04);
      touch-action: manipulation;
      transition: background 0.15s ease, color 0.15s ease;
    }

    .mobile-link:active,
    .mobile-link:hover {
      background: rgba(255, 255, 255, 0.06);
      color: var(--text);
    }

    /* Studios Collapsible Section */
    .studios-group {
      margin-top: 8px;
      background: rgba(255, 255, 255, 0.025);
      border: 1px solid var(--stroke);
      border-radius: 12px;
      overflow: hidden;
    }

    .studios-toggle-btn {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px 14px;
      background: transparent;
      border: none;
      color: var(--text);
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      touch-action: manipulation;
    }

    .studios-chevron {
      transition: transform 0.2s ease;
      color: var(--cyan);
    }

    .studios-toggle-btn[aria-expanded="true"] .studios-chevron {
      transform: rotate(180deg);
    }

    .studios-sublinks {
      display: flex;
      flex-direction: column;
      border-top: 1px solid rgba(255, 255, 255, 0.06);
    }

    .studios-sublinks.collapsed {
      display: none;
    }

    .mobile-sublink {
      display: flex;
      flex-direction: column;
      padding: 10px 14px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.04);
      transition: background 0.15s ease;
    }

    .mobile-sublink:last-child {
      border-bottom: none;
    }

    .mobile-sublink:hover,
    .mobile-sublink:active {
      background: rgba(97, 173, 255, 0.1);
    }

    .sublink-title {
      font-size: 14px;
      font-weight: 600;
      color: var(--text);
    }

    .sublink-tag {
      font-size: 11px;
      color: var(--cyan);
      margin-top: 2px;
      font-family: var(--font-mono);
    }

    .mobile-drawer-cta {
      margin-top: 2rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--stroke);
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
  }

  @media (max-width: 640px) {
    .nav-btn-primary {
      display: none;
    }

    .brand-sub {
      display: none;
    }

    .brand-title {
      font-size: 17px;
    }

    .brand-mark {
      width: 36px;
      height: 36px;
      border-radius: 10px;
      padding: 4px;
    }

    .mobile-drawer {
      width: 100vw;
      border-left: none;
    }
  }
</style>

<script>
  const toggleBtn = document.getElementById('mobile-menu-btn');
  const drawer = document.getElementById('mobile-drawer');
  const backdrop = document.getElementById('mobile-backdrop');
  const drawerCloseBtn = document.getElementById('drawer-close-btn');
  const mobileLinks = document.querySelectorAll('.mobile-link, .mobile-sublink, .mobile-drawer-cta a');
  const studiosToggle = document.getElementById('studios-toggle-btn');
  const studiosList = document.getElementById('studios-sublinks');

  function setDrawerOpen(open: boolean) {
    if (!toggleBtn || !drawer || !backdrop) return;
    toggleBtn.setAttribute('aria-expanded', open.toString());
    drawer.classList.toggle('open', open);
    backdrop.classList.toggle('open', open);

    if (open) {
      document.documentElement.style.overflow = 'hidden';
      document.body.style.overflow = 'hidden';
      document.body.style.touchAction = 'none';
    } else {
      document.documentElement.style.overflow = '';
      document.body.style.overflow = '';
      document.body.style.touchAction = '';
    }

    const menuIcon = toggleBtn.querySelector('.icon-menu') as HTMLElement;
    const closeIcon = toggleBtn.querySelector('.icon-close') as HTMLElement;
    if (menuIcon && closeIcon) {
      menuIcon.style.display = open ? 'none' : 'block';
      closeIcon.style.display = open ? 'block' : 'none';
    }
  }

  if (toggleBtn && drawer && backdrop) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      setDrawerOpen(!isExpanded);
    });

    if (drawerCloseBtn) {
      drawerCloseBtn.addEventListener('click', () => {
        setDrawerOpen(false);
      });
    }

    backdrop.addEventListener('click', () => {
      setDrawerOpen(false);
    });

    mobileLinks.forEach((link) => {
      link.addEventListener('click', () => {
        setDrawerOpen(false);
      });
    });

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && drawer.classList.contains('open')) {
        setDrawerOpen(false);
      }
    });

    window.addEventListener('resize', () => {
      if (window.innerWidth > 1140 && drawer.classList.contains('open')) {
        setDrawerOpen(false);
      }
    });
  }

  // Studios Accordion toggle inside drawer
  if (studiosToggle && studiosList) {
    studiosToggle.addEventListener('click', () => {
      const isExpanded = studiosToggle.getAttribute('aria-expanded') === 'true';
      studiosToggle.setAttribute('aria-expanded', (!isExpanded).toString());
      studiosList.classList.toggle('collapsed', isExpanded);
    });
  }
</script>
